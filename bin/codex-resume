#!/usr/bin/env bash
set -euo pipefail

# Resume into an existing tmux session without needing a manifest.
# Usage: codex-resume [session] [--board]

DEFAULT_SESSION="codexfarm"
PREFER_BOARD=0
SESSION_ARG=""
POSITIONALS=()

board_session_name() {
  local session="$1"
  if [ "$session" = "$DEFAULT_SESSION" ]; then
    printf '%s' "board"
  else
    printf '%s-board' "$session"
  fi
}

while (( "$#" )); do
  case "${1:-}" in
    -b|--board)
      PREFER_BOARD=1
      ;;
    -s|--session)
      if [ "$#" -lt 2 ]; then
        echo "Missing value for $1" >&2
        exit 2
      fi
      SESSION_ARG="$2"
      shift
      ;;
    -h|--help)
      cat <<EOF
Usage: $(basename "$0") [session] [--board]

Resumes an existing tmux session, preferring the selected farm if present.
Order: selected farm -> selected board -> last/most-recent tmux session.

Options:
  -b, --board          Prefer the selected board session first
  -s, --session NAME   Explicitly choose a farm/session name
  -h, --help           Show this help

Examples:
  $(basename "$0")
  $(basename "$0") work
  $(basename "$0") work --board
EOF
      exit 0
      ;;
    --)
      shift
      while (( "$#" )); do
        POSITIONALS+=("$1")
        shift
      done
      break
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 2
      ;;
    *)
      POSITIONALS+=("$1")
      ;;
  esac
  shift
done

if [ -z "$SESSION_ARG" ] && [ ${#POSITIONALS[@]} -gt 0 ]; then
  SESSION_ARG="${POSITIONALS[0]}"
fi

if ! command -v tmux >/dev/null; then
  echo "tmux not found" >&2
  exit 127
fi

SESSION_MAIN="${SESSION_ARG:-${CODEX_SESSION:-$DEFAULT_SESSION}}"
SESSION_BOARD="$(board_session_name "$SESSION_MAIN")"

inside_tmux=0
if [ -n "${TMUX:-}" ]; then
  inside_tmux=1
fi

attach_or_switch() {
  local target="$1"
  if [ "$inside_tmux" -eq 1 ]; then
    tmux switch-client -t "$target"
  else
    tmux attach -t "$target"
  fi
}

attach_if_exists() {
  local target="$1"
  if tmux has-session -t "$target" 2>/dev/null; then
    attach_or_switch "$target"
    return 0
  fi
  return 1
}

fallback_last() {
  if [ "$inside_tmux" -eq 1 ]; then
    if ! tmux switch-client -l 2>/dev/null; then
      echo "No alternate session to switch to (already in the only session)" >&2
      exit 1
    fi
  else
    if ! tmux attach 2>/dev/null; then
      echo "No tmux sessions to attach to" >&2
      exit 1
    fi
  fi
}

if ! tmux list-sessions >/dev/null 2>&1; then
  echo "No tmux server running; nothing to resume" >&2
  exit 1
fi

if [ "$PREFER_BOARD" -eq 1 ]; then
  attach_if_exists "$SESSION_BOARD" && exit 0
  attach_if_exists "$SESSION_MAIN" && exit 0
else
  attach_if_exists "$SESSION_MAIN" && exit 0
  attach_if_exists "$SESSION_BOARD" && exit 0
fi

fallback_last
