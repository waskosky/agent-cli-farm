#!/usr/bin/env bash
set -euo pipefail

# Auto-adopt all running Codex-like processes into tmux using reptyr
# Usage: codex-auto-adopt [-d]
# Flags:
#   -d, --detach   Do not attach/switch after adopting
# Env:
#   CODEX_SESSION  Tmux session name (default: codexfarm)
#   CODEX_MATCH    pgrep pattern (default: "\bcodex\b|\bcursor\b")

detach=0
args_pos=()
while (( "$#" )); do
  case "${1:-}" in
    -d|--detach) detach=1; shift ;;
    --) shift; while (( "$#" )); do args_pos+=("$1"); shift; done ;;
    -*) echo "Unknown option: $1" >&2; exit 2 ;;
    *) args_pos+=("$1"); shift ;;
  esac
done

if [ ${#args_pos[@]} -ne 0 ]; then
  echo "Usage: $(basename "$0") [-d]" >&2
  exit 1
fi

SESSION="${CODEX_SESSION:-codexfarm}"
MATCH="${CODEX_MATCH:-\bcodex\b|\bcursor\b}"

# Ensure tmux exists early
command -v tmux >/dev/null || { echo "tmux not found" >&2; exit 127; }

# Resolve codex-adopt binary (PATH or alongside this script)
ADOPT_BIN="${CODEX_ADOPT_BIN:-codex-adopt}"
if ! command -v "$ADOPT_BIN" >/dev/null 2>&1; then
  script_dir="$(cd "$(dirname "$0")" && pwd -P)"
  if [ -x "$script_dir/codex-adopt" ]; then
    ADOPT_BIN="$script_dir/codex-adopt"
  fi
fi

# Find candidate processes
mapfile -t lines < <(pgrep -fa "$MATCH" || true)

if [ ${#lines[@]} -eq 0 ]; then
  echo "No matching processes found ($MATCH)."
  exit 0
fi

to_adopt=()
declare -A kind  # pid -> kind (node_codex|codex|cursor|musl_codex|other)

# First pass: classify
for l in "${lines[@]}"; do
  pid=${l%% *}

  # Validate PID is accessible
  kill -0 "$pid" 2>/dev/null || continue

  # Skip if already under tmux (environment contains TMUX=)
  if [ -r "/proc/$pid/environ" ] && tr '\0' '\n' < "/proc/$pid/environ" | grep -q '^TMUX='; then
    continue
  fi

  # Read cmdline and argv0
  cmdline=""
  if [ -r "/proc/$pid/cmdline" ]; then
    cmdline=$(tr '\0' ' ' < "/proc/$pid/cmdline")
  fi
  cmd0=$(printf '%s' "$cmdline" | awk '{print $1}')
  base=$(basename -- "${cmd0:-}")

  # Exclude our helper scripts to avoid self-adoption
  if printf '%s' "$cmdline" | grep -Eq '\bcodex-(add|adopt|auto-adopt|watch|status|save|restore|board)\b'; then
    kind[$pid]=other
    continue
  fi

  # Classify
  if [ "$base" = "codex" ]; then
    kind[$pid]=codex
  elif [ "$base" = "cursor" ]; then
    kind[$pid]=cursor
  elif [ "$base" = "node" ] && printf '%s' "$cmdline" | grep -Eq '(/| )bin/codex( |$)'; then
    kind[$pid]=node_codex
  elif [ "$base" = "codex-x86_64-unknown-linux-musl" ]; then
    kind[$pid]=musl_codex
  else
    # Still allow if full cmdline clearly references codex/cursor
    if printf '%s' "$cmdline" | grep -Eq '\bcodex\b|\bcursor\b'; then
      kind[$pid]=codex
    else
      kind[$pid]=other
    fi
  fi
done

# Helper to read PPID
ppid_of() {
  # /proc/$1/stat field 4 is PPID
  awk '{print $4}' "/proc/$1/stat" 2>/dev/null || true
}

# Second pass: choose which to adopt
for l in "${lines[@]}"; do
  pid=${l%% *}
  k=${kind[$pid]:-other}
  case "$k" in
    node_codex|codex|cursor)
      to_adopt+=("$pid") ;;
    musl_codex)
      # Skip musl child if parent is a node codex (to avoid duplicates)
      ppid=$(ppid_of "$pid")
      if [ "${kind[$ppid]:-}" != "node_codex" ]; then
        to_adopt+=("$pid")
      fi
      ;;
    *)
      : ;; # ignore
  esac
done

if [ ${#to_adopt[@]} -eq 0 ]; then
  echo "Found candidates, but none required adoption (already in tmux or not primary CLI)."
  exit 0
fi

printf "Auto-adopting %d process(es) into session '%s'...\n" "${#to_adopt[@]}" "$SESSION"

for pid in "${to_adopt[@]}"; do
  echo "Adopting PID $pid ..."
  if [ "$detach" -eq 1 ]; then
    "$ADOPT_BIN" -d "$pid" || echo "Failed to adopt $pid" >&2
  else
    # If running inside tmux, avoid stealing focus repeatedly; adopt detached then select
    if [ -n "${TMUX:-}" ]; then
      "$ADOPT_BIN" -d "$pid" || echo "Failed to adopt $pid" >&2
    else
      "$ADOPT_BIN" "$pid" || echo "Failed to adopt $pid" >&2
    fi
  fi
done

if [ -n "${TMUX:-}" ] && [ "$detach" -eq 0 ]; then
  # If we're in tmux and adopted detached, switch to the last created window
  tmux last-window 2>/dev/null || true
fi

echo "Done. Attach with: tmux attach -t ${SESSION}"
