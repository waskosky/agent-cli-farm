#!/usr/bin/env bash
set -euo pipefail

# Snapshot the current Codex tmux windows to a manifest file
# Usage: codex-save [manifest-path]

usage() {
  cat <<EOF
Usage: $(basename "$0") [--all-registered] [manifest-path]

Snapshot tmux farm windows to a trusted restore manifest.
EOF
}

trim_command_field() {
  local value="$1"
  # Trim leading/trailing whitespace
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [ "${#value}" -ge 2 ]; then
    case "$value" in
      \"*\")
        value="${value%\"}"
        value="${value#\"}"
        ;;
      \'*\')
        value="${value%\'}"
        value="${value#\'}"
        ;;
    esac
    # Trim again in case whitespace was inside quotes
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
  fi
  case "$value" in
    "tmux set-window-option -q remain-on-exit on"*"; exec "*)
      value="${value#*; exec }"
      ;;
  esac
  printf '%s' "$value"
}

strip_status_prefix() {
  local value="$1"
  local old match
  while :; do
    old="$value"
    case "$value" in
      "*READY* "*) value="${value#\*READY\* }" ;;
      "*RUN* "*) value="${value#\*RUN\* }" ;;
      "*ERR* "*) value="${value#\*ERR\* }" ;;
    esac
    if [[ "$value" =~ ^\*[0-9]+(\.[0-9]+)?\+MB\*\*[[:space:]]* ]]; then
      match="${BASH_REMATCH[0]}"
      value="${value:${#match}}"
    fi
    [ "$value" = "$old" ] && break
  done
  printf '%s' "$value"
}

extract_uuid_from_session_path() {
  local path="$1"
  local base="${path##*/}"
  base="${base%.jsonl}"
  base="${base%.json}"
  if [[ "$base" =~ ([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}) ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  fi
}

extract_session_id_from_metadata() {
  local path="$1"
  local line count=0
  [ -r "$path" ] || return 1

  while IFS= read -r line && [ "$count" -lt 50 ]; do
    count=$((count + 1))
    if [[ "$line" =~ \"sessionId\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]]; then
      printf '%s' "${BASH_REMATCH[1]}"
      return 0
    fi
  done < "$path"

  return 1
}

session_file_matches_tool() {
  local tool="$1"
  local path="$2"
  case "$tool:$path" in
    codex:*/.codex/sessions/*.jsonl)
      return 0
      ;;
    claude:*/.claude/projects/*.jsonl)
      return 0
      ;;
    gemini:*/.gemini/*/chats/*.jsonl|gemini:*/.gemini/*/chats/*.json)
      return 0
      ;;
  esac
  return 1
}

session_id_from_path() {
  local path="$1"
  local session_id
  session_id="$(extract_uuid_from_session_path "$path")"
  if [ -n "$session_id" ]; then
    printf '%s' "$session_id"
    return 0
  fi

  extract_session_id_from_metadata "$path"
}

descendant_pids() {
  local root="$1"
  local pid child
  printf '%s\n' "$root"

  command -v pgrep >/dev/null 2>&1 || return 0

  local queue=("$root")
  local index=0
  while [ "$index" -lt "${#queue[@]}" ]; do
    pid="${queue[$index]}"
    index=$((index + 1))
    while IFS= read -r child; do
      [ -z "$child" ] && continue
      printf '%s\n' "$child"
      queue+=("$child")
    done < <(pgrep -P "$pid" 2>/dev/null || true)
  done
}

session_id_from_lsof() {
  local tool="$1"
  local pane_pid="$2"
  local pid line path session_id
  [ -n "$pane_pid" ] || return 1
  command -v lsof >/dev/null 2>&1 || return 1

  while IFS= read -r pid; do
    [ -z "$pid" ] && continue
    while IFS= read -r line; do
      case "$line" in
        n*)
          path="${line#n}"
          if session_file_matches_tool "$tool" "$path"; then
            session_id="$(session_id_from_path "$path" || true)"
            if [ -n "$session_id" ]; then
              printf '%s' "$session_id"
              return 0
            fi
          fi
          ;;
      esac
    done < <(lsof -Fn -p "$pid" 2>/dev/null || true)
  done < <(descendant_pids "$pane_pid")

  return 1
}

tool_from_command() {
  local value
  value="$(trim_command_field "$1")"
  local first="${value%%[[:space:]]*}"
  local base="${first##*/}"
  case "$base" in
    codex|claude|gemini)
      printf '%s' "$base"
      return 0
      ;;
  esac
  return 1
}

resume_args_for_pane() {
  local tool="$1"
  local pane_pid="$2"
  local session_id
  session_id="$(session_id_from_lsof "$tool" "$pane_pid" || true)"
  case "$tool" in
    codex)
      if [ -n "$session_id" ]; then
        printf 'resume %s' "$session_id"
      else
        printf 'resume --last'
      fi
      ;;
    claude)
      if [ -n "$session_id" ]; then
        printf -- '--resume %s' "$session_id"
      else
        printf -- '--continue'
      fi
      ;;
    gemini)
      if [ -n "$session_id" ]; then
        printf -- '--resume %s' "$session_id"
      else
        printf -- '--resume latest'
      fi
      ;;
  esac
}

DEFAULT_SESSION="codexfarm"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/codexfarm"
AUTOSERVICE_REGISTRY="$CONFIG_DIR/farms.tsv"

safe_name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

default_manifest_path_for_session() {
  local session="$1"
  if [ "$session" = "$DEFAULT_SESSION" ]; then
    printf '%s/manifest.tsv' "$CONFIG_DIR"
  else
    printf '%s/manifests/%s.tsv' "$CONFIG_DIR" "$(safe_name "$session")"
  fi
}

save_all_registered() {
  local session manifest status count
  status=0
  count=0
  if [ ! -f "$AUTOSERVICE_REGISTRY" ]; then
    echo "No registered farms found at $AUTOSERVICE_REGISTRY"
    return 0
  fi

  while IFS=$'\t' read -r session manifest _rest || [ -n "${session:-}" ]; do
    case "${session:-}" in
      ""|"session"|\#*) continue ;;
    esac
    if [ -z "${manifest:-}" ]; then
      manifest="$(default_manifest_path_for_session "$session")"
    fi
    if CODEX_SESSION="$session" "$0" "$manifest"; then
      count=$((count + 1))
    else
      status=1
    fi
  done < "$AUTOSERVICE_REGISTRY"

  echo "Autosaved $count registered farm(s)"
  return "$status"
}

all_registered=0
args_pos=()
while (( "$#" )); do
  case "${1:-}" in
    -h|--help)
      usage
      exit 0
      ;;
    --all-registered)
      all_registered=1
      shift
      ;;
    --)
      shift
      while (( "$#" )); do
        args_pos+=("$1")
        shift
      done
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 2
      ;;
    *)
      args_pos+=("$1")
      shift
      ;;
  esac
done

if [ "${#args_pos[@]}" -gt 1 ]; then
  echo "Unexpected argument: ${args_pos[1]}" >&2
  exit 2
fi

if [ "$all_registered" -eq 1 ] && [ "${#args_pos[@]}" -gt 0 ]; then
  echo "--all-registered cannot be combined with a manifest path" >&2
  exit 2
fi

if [ "$all_registered" -eq 1 ]; then
  save_all_registered
  exit $?
fi

SESSION="${CODEX_SESSION:-$DEFAULT_SESSION}"
MANIFEST_PATH="${args_pos[0]:-$(default_manifest_path_for_session "$SESSION")}"

if ! command -v tmux >/dev/null; then
  echo "tmux not found" >&2
  exit 127
fi

if ! tmux has-session -t "$SESSION" 2>/dev/null; then
  echo "Main session '$SESSION' is not running" >&2
  exit 1
fi

mkdir -p "$(dirname "$MANIFEST_PATH")"

tmpfile=$(mktemp "$(dirname "$MANIFEST_PATH")/.manifest.XXXXXX")
chmod 600 "$tmpfile" 2>/dev/null || true
trap 'rm -f "$tmpfile"' EXIT

printf 'name\tdir\tcmd\targs\n' > "$tmpfile"

# Collect windows, skipping the initial 'home' window if present
while IFS=$'\n' read -r idx; do
  name=$(tmux display-message -p -t "$SESSION:$idx" '#{window_name}')
  name=$(strip_status_prefix "$name")
  [ "$name" = "home" ] && continue
  # Prefer the first pane's path
  dir=$(tmux display-message -p -t "$SESSION:$idx.0" '#{pane_current_path}')
  # Best-effort: starting command (may be sh/bash)
  cmd=$(tmux display-message -p -t "$SESSION:$idx.0" '#{pane_start_command}')
  pane_pid=$(tmux display-message -p -t "$SESSION:$idx.0" '#{pane_pid}')
  args=
  tool="$(tool_from_command "$cmd" || true)"
  case "$tool" in
    codex)
      cmd="codex"
      args="$(resume_args_for_pane "$tool" "$pane_pid")"
      ;;
    claude)
      cmd="claude"
      args="$(resume_args_for_pane "$tool" "$pane_pid")"
      ;;
    gemini)
      cmd="gemini"
      args="$(resume_args_for_pane "$tool" "$pane_pid")"
      ;;
    *)
      cmd=$(trim_command_field "$cmd")
      ;;
  esac
  # Sanitize tabs
  name=${name//$'\t'/ }
  dir=${dir//$'\t'/ }
  cmd=${cmd//$'\t'/ }
  args=${args//$'\t'/ }
  printf '%s\t%s\t%s\t%s\n' "$name" "$dir" "$cmd" "$args" >> "$tmpfile"
done < <(tmux list-windows -t "$SESSION" -F '#{window_index}')

mv "$tmpfile" "$MANIFEST_PATH"
chmod 600 "$MANIFEST_PATH" 2>/dev/null || true
echo "Saved manifest to $MANIFEST_PATH"
