#!/usr/bin/env bash
set -euo pipefail

# Snapshot the current Codex tmux windows to a manifest file
# Usage: codex-save [--autosave] [manifest-path]

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SESSION_META_BIN="${CODEX_SESSION_META_BIN:-$SCRIPT_DIR/codex-session-meta.py}"
MANIFEST_BIN="$SCRIPT_DIR/codex-manifest.py"
original_args=("$@")

usage() {
  cat <<EOF
Usage: $(basename "$0") [--all-registered] [--autosave] [manifest-path]

Snapshot tmux farm windows to a trusted restore manifest.

Recognized provider panes require an exact session ID. Latest-session fallbacks
are disabled. All distinct snapshots are retained in <manifest-path>.history/.
--autosave preserves the restore point when saved conversations would be lost.
--all-registered always uses this conservative autosave policy.
EOF
}

trim_command_field() {
  local value="$1"
  # Trim leading/trailing whitespace
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [ "${#value}" -ge 2 ]; then
    case "$value" in
      \"*\")
        value="${value%\"}"
        value="${value#\"}"
        ;;
      \'*\')
        value="${value%\'}"
        value="${value#\'}"
        ;;
    esac
    # Trim again in case whitespace was inside quotes
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
  fi
  case "$value" in
    "tmux set-window-option -q remain-on-exit on"*"; exec "*)
      value="${value#*; exec }"
      ;;
  esac
  printf '%s' "$value"
}

strip_status_prefix() {
  local value="$1"
  local old match
  while :; do
    old="$value"
    case "$value" in
      "*READY* "*) value="${value#\*READY\* }" ;;
      "*RUN* "*) value="${value#\*RUN\* }" ;;
      "*ERR* "*) value="${value#\*ERR\* }" ;;
    esac
    if [[ "$value" =~ ^\*[0-9]+(\.[0-9]+)?\+?MB\*\*[[:space:]]* ]]; then
      match="${BASH_REMATCH[0]}"
      value="${value:${#match}}"
    fi
    [ "$value" = "$old" ] && break
  done
  printf '%s' "$value"
}

extract_uuid_from_session_path() {
  local path="$1"
  local base="${path##*/}"
  base="${base%.jsonl}"
  base="${base%.json}"
  if [[ "$base" =~ ([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}) ]]; then
    printf '%s' "${BASH_REMATCH[1]}"
  fi
}

valid_session_id() {
  [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
}

resumable_session_id() {
  local tool="$1"
  local session_id="$2"
  local resolved=""
  if [ "$tool" = "codex" ] && [ -x "$SESSION_META_BIN" ]; then
    resolved="$("$SESSION_META_BIN" resolve-id "$session_id" 2>/dev/null || true)"
    if valid_session_id "$resolved"; then
      printf '%s' "$resolved"
      return 0
    fi
  fi
  printf '%s' "$session_id"
}

pane_option() {
  local pane_target="$1"
  local option="$2"
  tmux show-options -p -v -t "$pane_target" "$option" 2>/dev/null || true
}

extract_session_id_from_metadata() {
  local path="$1"
  local line count=0
  [ -r "$path" ] || return 1

  while IFS= read -r line && [ "$count" -lt 50 ]; do
    count=$((count + 1))
    if [[ "$line" =~ \"sessionId\"[[:space:]]*:[[:space:]]*\"([^\"]+)\" ]]; then
      printf '%s' "${BASH_REMATCH[1]}"
      return 0
    fi
  done < "$path"

  return 1
}

session_file_matches_tool() {
  local tool="$1"
  local path="$2"
  case "$tool:$path" in
    codex:*/.codex/sessions/*.jsonl|codex:*/sessions/*/rollout-*.jsonl)
      return 0
      ;;
    claude:*/.claude/projects/*.jsonl)
      return 0
      ;;
    gemini:*/.gemini/*/chats/*.jsonl|gemini:*/.gemini/*/chats/*.json)
      return 0
      ;;
  esac
  return 1
}

session_id_from_path() {
  local tool="$1"
  local path="$2"
  local session_id=""
  if [ "$tool" = "codex" ] && [ -x "$SESSION_META_BIN" ]; then
    session_id="$("$SESSION_META_BIN" resolve-path "$path" 2>/dev/null || true)"
    if valid_session_id "$session_id"; then
      printf '%s' "$session_id"
      return 0
    fi
    return 1
  fi
  session_id="$(extract_uuid_from_session_path "$path")"
  if [ -n "$session_id" ]; then
    printf '%s' "$session_id"
    return 0
  fi

  extract_session_id_from_metadata "$path"
}

descendant_pids() {
  local root="$1"
  local pid child
  printf '%s\n' "$root" 2>/dev/null || return 0

  command -v pgrep >/dev/null 2>&1 || return 0

  local queue=("$root")
  local index=0
  while [ "$index" -lt "${#queue[@]}" ]; do
    pid="${queue[$index]}"
    index=$((index + 1))
    while IFS= read -r child; do
      [ -z "$child" ] && continue
      # Consumers stop at the first provider. A closed pipe is normal, and
      # discovery must not eagerly walk every test/build descendant first.
      printf '%s\n' "$child" 2>/dev/null || return 0
      queue+=("$child")
    done < <(pgrep -P "$pid" 2>/dev/null || true)
  done
}

session_id_from_procfs() {
  local tool="$1"
  local pid="$2"
  local descriptor path session_id resolution_status
  local proc_root="${CODEX_PROC_ROOT:-/proc}"
  [ -d "$proc_root/$pid/fd" ] || return 1

  if [ "$tool" = "codex" ] && [ -x "$SESSION_META_BIN" ]; then
    if session_id="$("$SESSION_META_BIN" resolve-pid "$pid" 2>/dev/null)"; then
      if valid_session_id "$session_id"; then
        printf '%s' "$session_id"
        return 0
      fi
    else
      resolution_status=$?
      # An in-TUI fork can keep multiple independent writers in one process.
      # Without fresh hook metadata, choosing an arbitrary rollout is unsafe.
      [ "$resolution_status" -ne 3 ] || return 3
    fi
  fi

  for descriptor in "$proc_root/$pid/fd"/*; do
    [ -e "$descriptor" ] || [ -L "$descriptor" ] || continue
    path="$(readlink "$descriptor" 2>/dev/null || true)"
    path="${path% (deleted)}"
    if session_file_matches_tool "$tool" "$path"; then
      session_id="$(session_id_from_path "$tool" "$path" || true)"
      if [ -n "$session_id" ]; then
        printf '%s\n' "$session_id"
      fi
    fi
  done
  return 0
}

session_id_from_process_files() {
  local tool="$1"
  local pane_pid="$2"
  local provider_pid="${3:-}"
  local pid line path session_id resolution_status
  local pids=()
  [ -n "$pane_pid" ] || return 1

  # A uniquely held writer belongs to the pane's provider. Its helper processes
  # may read other transcripts without changing the active conversation.
  if [ "$tool" = codex ] && [ -n "$provider_pid" ] && [ -x "$SESSION_META_BIN" ]; then
    if session_id="$("$SESSION_META_BIN" resolve-pid "$provider_pid" 2>/dev/null)"; then
      if valid_session_id "$session_id"; then
        printf '%s' "$session_id"
        return 0
      fi
    else
      resolution_status=$?
      [ "$resolution_status" -ne 3 ] || return 3
    fi
  fi

  while IFS= read -r pid; do
    [ -n "$pid" ] && pids+=("$pid")
  done < <(descendant_pids "${provider_pid:-$pane_pid}")

  local candidates=""
  for pid in "${pids[@]}"; do
    if session_id="$(session_id_from_procfs "$tool" "$pid")"; then
      :
    else
      resolution_status=$?
      [ "$resolution_status" -ne 3 ] || return 3
    fi
    if [ -n "$session_id" ]; then
      candidates+="$session_id"$'\n'
    fi
  done

  if [ -z "$candidates" ] && command -v lsof >/dev/null 2>&1; then
    for pid in "${pids[@]}"; do
      [ -z "$pid" ] && continue
      while IFS= read -r line; do
        case "$line" in
          n*)
            path="${line#n}"
            if session_file_matches_tool "$tool" "$path"; then
              session_id="$(session_id_from_path "$tool" "$path" || true)"
              if [ -n "$session_id" ]; then
                candidates+="$session_id"$'\n'
              fi
            fi
            ;;
        esac
      done < <(lsof -Fn -p "$pid" 2>/dev/null || true)
    done
  fi

  candidates="$(printf '%s' "$candidates" | sort -u)"
  if valid_session_id "$candidates"; then
    printf '%s' "$candidates"
    return 0
  fi
  [ -z "$candidates" ] || echo "Ambiguous $tool session files in pane process tree; refusing to guess." >&2
  return 1
}

tool_from_command() {
  local value
  value="$(trim_command_field "$1")"
  local first="${value%%[[:space:]]*}"
  local base="${first##*/}"
  case "$base" in
    codex|claude|gemini)
      printf '%s' "$base"
      return 0
      ;;
  esac
  return 1
}

tool_from_process_argv() {
  local token base
  local tokens=()
  read -r -a tokens <<< "$1"
  for token in "${tokens[@]}"; do
    token="${token#\"}"
    token="${token%\"}"
    token="${token#\'}"
    token="${token%\'}"
    base="${token##*/}"
    case "$base" in
      codex|codex.js|codex.exe|claude|claude.exe|gemini|gemini.js|gemini.exe)
        printf '%s' "${base%%.*}"
        return 0
        ;;
    esac
  done
  return 1
}

tool_from_process_tree() {
  local pane_pid="$1"
  local pid value tool
  [ -n "$pane_pid" ] || return 1
  command -v ps >/dev/null 2>&1 || return 1

  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    value="$(ps -p "$pid" -o comm= 2>/dev/null || true)"
    tool="$(tool_from_command "$value" || true)"
    if [ -n "$tool" ]; then
      printf '%s' "$tool"
      return 0
    fi

    value="$(ps -p "$pid" -o args= 2>/dev/null || true)"
    tool="$(tool_from_process_argv "$value" || true)"
    if [ -n "$tool" ]; then
      printf '%s' "$tool"
      return 0
    fi
  done < <(descendant_pids "$pane_pid")

  return 1
}

provider_pid_from_process_tree() {
  local tool="$1"
  local pane_pid="$2"
  local pid value detected fallback=""
  [ -n "$pane_pid" ] || return 1
  command -v ps >/dev/null 2>&1 || return 1

  while IFS= read -r pid; do
    [ -n "$pid" ] || continue
    value="$(ps -p "$pid" -o comm= 2>/dev/null || true)"
    detected="$(tool_from_command "$value" || true)"
    if [ "$detected" = "$tool" ]; then
      printf '%s' "$pid"
      return 0
    fi

    if [ -z "$fallback" ]; then
      value="$(ps -p "$pid" -o args= 2>/dev/null || true)"
      detected="$(tool_from_process_argv "$value" || true)"
      if [ "$detected" = "$tool" ]; then
        fallback="$pid"
      fi
    fi
  done < <(descendant_pids "$pane_pid")

  [ -n "$fallback" ] || return 1
  printf '%s' "$fallback"
}

session_id_for_pane() {
  local tool="$1"
  local pane_target="$2"
  local pane_pid="$3"
  local provider_pid="${4:-}"
  local pane_dead="${5:-0}"
  local session_id metadata_pid

  session_id="$(pane_option "$pane_target" @codexfarm_session_id)"
  metadata_pid="$(pane_option "$pane_target" @codexfarm_session_pid)"
  if valid_session_id "$session_id" \
    && { [ "$pane_dead" = "1" ] \
      || { [ -n "$provider_pid" ] && [ "$metadata_pid" = "$provider_pid" ]; }; }
  then
    resumable_session_id "$tool" "$session_id"
    return 0
  fi

  session_id="$(session_id_from_process_files "$tool" "$pane_pid" "$provider_pid" || true)"
  if valid_session_id "$session_id"; then
    printf '%s' "$session_id"
    return 0
  fi
  return 1
}

provider_for_pane() {
  local pane_target="$1" pane_pid="$2" start_command="$3" current_command="$4"
  local tool
  tool="$(pane_option "$pane_target" @codexfarm_provider)"
  case "$tool" in
    codex|claude|gemini) ;;
    *) tool="" ;;
  esac
  [ -n "$tool" ] || tool="$(tool_from_command "$start_command" || true)"
  [ -n "$tool" ] || tool="$(tool_from_command "$current_command" || true)"
  [ -n "$tool" ] || tool="$(tool_from_process_tree "$pane_pid" || true)"
  printf '%s' "$tool"
}

inspect_pane() {
  local pane="$1" start_command current_command pid dead tool provider_pid session_id
  start_command=$(tmux display-message -p -t "$pane" '#{pane_start_command}') || return 1
  current_command=$(tmux display-message -p -t "$pane" '#{pane_current_command}') || return 1
  pid=$(tmux display-message -p -t "$pane" '#{pane_pid}') || return 1
  dead=$(tmux display-message -p -t "$pane" '#{pane_dead}') || return 1
  tool="$(provider_for_pane "$pane" "$pid" "$start_command" "$current_command")"
  [ -n "$tool" ] || return 1
  provider_pid="$(provider_pid_from_process_tree "$tool" "$pid" || true)"
  session_id="$(session_id_for_pane "$tool" "$pane" "$pid" "$provider_pid" "$dead")" || return 1
  printf '%s\t%s\n' "$tool" "$session_id"
}

exact_resume_args() {
  local tool="$1"
  local session_id="$2"
  case "$tool" in
    codex) printf 'resume %s' "$session_id" ;;
    claude|gemini) printf -- '--resume %s' "$session_id" ;;
  esac
}

DEFAULT_SESSION="codexfarm"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/codexfarm"
AUTOSERVICE_REGISTRY="$CONFIG_DIR/farms.tsv"

safe_name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

default_manifest_path_for_session() {
  local session="$1"
  if [ "$session" = "$DEFAULT_SESSION" ]; then
    printf '%s/manifest.tsv' "$CONFIG_DIR"
  else
    printf '%s/manifests/%s.tsv' "$CONFIG_DIR" "$(safe_name "$session")"
  fi
}

save_all_registered() {
  local session manifest status count
  status=0
  count=0
  if [ ! -f "$AUTOSERVICE_REGISTRY" ]; then
    echo "No registered farms found at $AUTOSERVICE_REGISTRY"
    return 0
  fi

  while IFS=$'\t' read -r session manifest _rest || [ -n "${session:-}" ]; do
    case "${session:-}" in
      ""|"session"|\#*) continue ;;
    esac
    if [ -z "${manifest:-}" ]; then
      manifest="$(default_manifest_path_for_session "$session")"
    fi
    if CODEX_SESSION="$session" "$0" --autosave "$manifest"; then
      count=$((count + 1))
    else
      status=1
    fi
  done < "$AUTOSERVICE_REGISTRY"

  echo "Autosaved $count registered farm(s)"
  return "$status"
}

# Internal read-only identity query shared with restore. Never writes a manifest.
if [ "${1:-}" = "--inspect-pane" ]; then
  [ "$#" -eq 2 ] || exit 2
  inspect_pane "$2"
  exit $?
fi

all_registered=0
autosave=0
args_pos=()
while (( "$#" )); do
  case "${1:-}" in
    -h|--help)
      usage
      exit 0
      ;;
    --all-registered)
      all_registered=1
      shift
      ;;
    --autosave)
      autosave=1
      shift
      ;;
    --)
      shift
      while (( "$#" )); do
        args_pos+=("$1")
        shift
      done
      ;;
    -*)
      echo "Unknown option: $1" >&2
      exit 2
      ;;
    *)
      args_pos+=("$1")
      shift
      ;;
  esac
done

if [ "${#args_pos[@]}" -gt 1 ]; then
  echo "Unexpected argument: ${args_pos[1]}" >&2
  exit 2
fi

if [ "$all_registered" -eq 1 ] && [ "${#args_pos[@]}" -gt 0 ]; then
  echo "--all-registered cannot be combined with a manifest path" >&2
  exit 2
fi

if [ "$all_registered" -eq 1 ]; then
  save_all_registered
  exit $?
fi

SESSION="${CODEX_SESSION:-$DEFAULT_SESSION}"
MANIFEST_PATH="${args_pos[0]:-$(default_manifest_path_for_session "$SESSION")}"

if [ "${CODEXFARM_LOCKED_MANIFEST:-}" != "$MANIFEST_PATH" ] \
  || [ "${CODEXFARM_LOCK_PARENT_PID:-}" != "$PPID" ]; then
  exec python3 "$MANIFEST_BIN" lock-run "$MANIFEST_PATH" "$0" "${original_args[@]}"
fi
export CODEXFARM_LOCK_SCRIPT_PID=$$

if ! command -v tmux >/dev/null; then
  echo "tmux not found" >&2
  exit 127
fi

if ! tmux has-session -t "=$SESSION" 2>/dev/null; then
  if [ "$autosave" -eq 1 ]; then
    echo "Autosave skipped: farm '$SESSION' is not running; previous snapshot preserved."
    exit 0
  fi
  echo "Main session '$SESSION' is not running" >&2
  exit 1
fi

mkdir -p "$(dirname "$MANIFEST_PATH")"

tmpfile=$(mktemp "$(dirname "$MANIFEST_PATH")/.manifest.XXXXXX")
chmod 600 "$tmpfile" 2>/dev/null || true
trap 'rm -f "$tmpfile"' EXIT

printf 'name\tdir\tcmd\targs\n' > "$tmpfile"
unresolved_sessions=0
saved_windows=0
if ! window_indexes="$(tmux list-windows -t "=$SESSION" -F '#{window_index}')"; then
  echo "Unable to list farm windows; previous snapshot preserved." >&2
  exit 1
fi

# Collect windows, skipping the initial 'home' window if present
while IFS=$'\n' read -r idx; do
  [ -n "$idx" ] || continue
  pane_target="=$SESSION:$idx.0"
  name=$(tmux display-message -p -t "=$SESSION:$idx" '#{window_name}')
  name=$(strip_status_prefix "$name")
  stable_name="$(pane_option "$pane_target" @codexfarm_name)"
  if [ -n "$stable_name" ]; then
    name="$stable_name"
  fi
  [ "$name" = "home" ] && continue
  # Prefer the first pane's path
  dir=$(tmux display-message -p -t "$pane_target" '#{pane_current_path}')
  # Best-effort: starting command (often sh/bash for a long-lived pane)
  cmd=$(tmux display-message -p -t "$pane_target" '#{pane_start_command}')
  current_cmd=$(tmux display-message -p -t "$pane_target" '#{pane_current_command}')
  pane_pid=$(tmux display-message -p -t "$pane_target" '#{pane_pid}')
  pane_dead=$(tmux display-message -p -t "$pane_target" '#{pane_dead}' 2>/dev/null || true)
  args=
  tool="$(provider_for_pane "$pane_target" "$pane_pid" "$cmd" "$current_cmd")"
  provider_pid=""
  if [ -n "$tool" ]; then
    provider_pid="$(provider_pid_from_process_tree "$tool" "$pane_pid" || true)"
    session_id="$(
      session_id_for_pane \
        "$tool" "$pane_target" "$pane_pid" "$provider_pid" "$pane_dead" || true
    )"
  fi
  case "$tool" in
    codex|claude|gemini)
      cmd="$tool"
      if [ -n "$session_id" ]; then
        args="$(exact_resume_args "$tool" "$session_id")"
      else
        unresolved_sessions=$((unresolved_sessions + 1))
        echo "Unable to resolve exact $tool session for window '$name'." >&2
      fi
      ;;
    *)
      cmd=$(trim_command_field "$cmd")
      cmd="${cmd:-$current_cmd}"
      ;;
  esac
  for field in "$name" "$dir" "$cmd" "$args"; do
    if [[ "$field" == *$'\t'* || "$field" == *$'\n'* || "$field" == *$'\r'* ]]; then
      echo "Window contains an unsupported TSV delimiter; previous snapshot preserved." >&2
      exit 1
    fi
  done
  printf '%s\t%s\t%s\t%s\n' "$name" "$dir" "$cmd" "$args" >> "$tmpfile"
  saved_windows=$((saved_windows + 1))
done <<< "$window_indexes"

if [ "$unresolved_sessions" -ne 0 ]; then
  echo "Manifest was not replaced. Exact session identity is required; latest-session guessing is disabled." >&2
  echo "Check codex-doctor and the session hook, then retry after the provider has recorded a conversation." >&2
  exit 1
fi

if [ "$saved_windows" -eq 0 ]; then
  echo "No restorable windows; previous snapshot preserved." >&2
  [ "$autosave" -eq 1 ] && exit 0
  exit 1
fi
if ! final_indexes="$(tmux list-windows -t "=$SESSION" -F '#{window_index}')" \
  || [ "$final_indexes" != "$window_indexes" ]; then
  echo "Farm windows changed during capture; previous snapshot preserved. Retry save." >&2
  exit 1
fi
publish_args=()
[ "$autosave" -eq 0 ] || publish_args+=(--autosave)
python3 "$MANIFEST_BIN" publish "$tmpfile" "$MANIFEST_PATH" "${publish_args[@]}"
