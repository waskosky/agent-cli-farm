#!/usr/bin/env bash
set -euo pipefail

script_name=$(basename "${0:-codex-add}")
tool_name="${CODEX_TOOL_NAME:-codex}"
case "$script_name" in
  claude-add) tool_name="${CODEX_TOOL_NAME:-claude}" ;;
  gemini-add) tool_name="${CODEX_TOOL_NAME:-gemini}" ;;
esac

# Portable uppercasing for older macOS bash (no ${var^^})
TOOL_PREFIX=$(printf '%s' "$tool_name" | tr '[:lower:]' '[:upper:]')

usage() {
  cat <<EOF
Usage: $script_name [options] [farm|dir] [dir] [-- tool-arg ...]

Start a provider CLI in a tmux farm window.

Options:
  -d, --detach              Start without attaching
  -s, --session SESSION     Target farm session
  --install-autoservice     Install autosave/autorestore units only
  -h, --help                Show this help

One non-path positional value is treated as a farm name. Use --session to avoid
ambiguity. Arguments after -- are passed to the provider as data. CODEX_ARGS,
CLAUDE_ARGS, and GEMINI_ARGS remain trusted shell fragments for compatibility.
CODEXFARM_HISTORY_BACKEND selects auto, legacy, or deep-history logging.
EOF
}

get_env() {
  # Prefer tool-specific env var, then CODEX_*, then default.
  local key="${TOOL_PREFIX}_$1"
  local fallback="CODEX_$1"
  local default="${2:-}"
  local val="${!key:-}"
  if [ -z "$val" ]; then
    val="${!fallback:-}"
  fi
  printf '%s' "${val:-$default}"
}

looks_like_path() {
  local value="${1:-}"
  case "$value" in
    "" ) return 1 ;;
    .|..|~|~/*|/*|./*|../*|*/*) return 0 ;;
  esac
  [ -e "$value" ]
}

board_session_name() {
  local session="$1"
  local default_session="$2"
  if [ "$session" = "$default_session" ]; then
    printf '%s' "board"
  else
    printf '%s-board' "$session"
  fi
}

safe_name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

default_manifest_path_for_session() {
  local session="$1"
  if [ "$session" = "$DEFAULT_SESSION" ]; then
    printf '%s/manifest.tsv' "$CONFIG_DIR"
  else
    printf '%s/manifests/%s.tsv' "$CONFIG_DIR" "$(safe_name "$session")"
  fi
}

register_managed_session() {
  mkdir -p "$(dirname "$ANNOTATOR_SESSION_REGISTRY")"
  if [ ! -f "$ANNOTATOR_SESSION_REGISTRY" ]; then
    ( umask 077; : > "$ANNOTATOR_SESSION_REGISTRY" )
  fi
  chmod 600 "$ANNOTATOR_SESSION_REGISTRY" 2>/dev/null || true
  if ! grep -Fxq -- "$SESSION" "$ANNOTATOR_SESSION_REGISTRY"; then
    printf '%s\n' "$SESSION" >> "$ANNOTATOR_SESSION_REGISTRY"
  fi
}

register_autoservice_farm() {
  local manifest tmp registry_dir
  manifest="$(default_manifest_path_for_session "$SESSION")"
  mkdir -p "$CONFIG_DIR" "$(dirname "$manifest")"
  registry_dir="$(dirname "$AUTOSERVICE_REGISTRY")"
  mkdir -p "$registry_dir"
  tmp="$(mktemp "$registry_dir/.farms.tsv.XXXXXX")"
  chmod 600 "$tmp" 2>/dev/null || true
  printf 'session\tmanifest\n' > "$tmp"
  if [ -f "$AUTOSERVICE_REGISTRY" ]; then
    awk -F '\t' -v session="$SESSION" \
      'NF && $1 != "session" && $1 != session { print }' \
      "$AUTOSERVICE_REGISTRY" >> "$tmp"
  fi
  printf '%s\t%s\n' "$SESSION" "$manifest" >> "$tmp"
  mv "$tmp" "$AUTOSERVICE_REGISTRY"
  chmod 600 "$AUTOSERVICE_REGISTRY" 2>/dev/null || true
}

valid_session_name() {
  local value="$1"
  [ -n "$value" ] || return 1
  case "$value" in
    *:*|*$'\n'*|*$'\r'*|*$'\t'*) return 1 ;;
  esac
  return 0
}

valid_window_name() {
  local value="$1"
  [ -n "$value" ] || return 1
  case "$value" in
    *$'\n'*|*$'\r'*|*$'\t'*) return 1 ;;
  esac
  return 0
}

false_value() {
  case "${1:-}" in
    0|false|FALSE|False|off|OFF|Off|no|NO|No) return 0 ;;
    *) return 1 ;;
  esac
}

resolve_executable() {
  local candidate="$1"
  case "$candidate" in
    */*) [ -x "$candidate" ] && printf '%s\n' "$candidate" ;;
    *) command -v "$candidate" 2>/dev/null ;;
  esac
}

python_is_supported() {
  "$1" -c 'import sys; raise SystemExit(0 if sys.version_info >= (3, 10) else 1)' \
    >/dev/null 2>&1
}

resolve_deep_history_python() {
  local candidate resolved
  for candidate in \
    "${CODEXFARM_DEEP_HISTORY_PYTHON_BIN:-}" \
    "${TMUX_DEEP_HISTORY_PYTHON:-}" \
    "${CODEXFARM_PYTHON_BIN:-}" \
    python3.14 \
    python3.13 \
    python3.12 \
    python3.11 \
    python3.10 \
    python3
  do
    [ -n "$candidate" ] || continue
    if resolved="$(resolve_executable "$candidate")" && python_is_supported "$resolved"; then
      printf '%s\n' "$resolved"
      return 0
    fi
  done
  return 1
}

detach=0
dir_arg=
session_arg=
positionals=()
tool_args=()
install_autoservice_only=0
while (( "$#" )); do
  case "${1:-}" in
    -d|--detach)
      detach=1
      ;;
    -s|--session)
      if [ "$#" -lt 2 ]; then
        echo "Missing value for $1" >&2
        exit 2
      fi
      session_arg="$2"
      shift
      ;;
    --install-autoservice)
      install_autoservice_only=1
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    -dsp)
      if [ "$tool_name" = "claude" ]; then
        tool_args+=("--dangerously-skip-permissions")
      else
        tool_args+=("$1")
      fi
      ;;
    --dangerously-skip-permissions)
      tool_args+=("$1")
      ;;
    --)
      shift
      while (( "$#" )); do
        tool_args+=("$1")
        shift
      done
      break
      ;;
    -*)
      tool_args+=("$1")
      ;;
    *)
      positionals+=("$1")
      ;;
  esac
  shift
done

DEFAULT_SESSION="codexfarm"
if [ -n "$session_arg" ]; then
  if [ ${#positionals[@]} -gt 0 ]; then
    dir_arg="${positionals[0]}"
  fi
  if [ ${#positionals[@]} -gt 1 ]; then
    tool_args+=("${positionals[@]:1}")
  fi
elif [ ${#positionals[@]} -eq 1 ]; then
  if looks_like_path "${positionals[0]}"; then
    dir_arg="${positionals[0]}"
  else
    session_arg="${positionals[0]}"
  fi
elif [ ${#positionals[@]} -ge 2 ]; then
  if looks_like_path "${positionals[0]}"; then
    dir_arg="${positionals[0]}"
    tool_args+=("${positionals[@]:1}")
  else
    session_arg="${positionals[0]}"
    dir_arg="${positionals[1]}"
    if [ ${#positionals[@]} -gt 2 ]; then
      tool_args+=("${positionals[@]:2}")
    fi
  fi
fi

SESSION="${session_arg:-$(get_env SESSION "$DEFAULT_SESSION")}"
BOARD_SESSION="$(board_session_name "$SESSION" "$DEFAULT_SESSION")"
DIR="${dir_arg:-$PWD}"
NAME="$(get_env NAME "$(basename "$DIR")")"
CMD="$(get_env CMD "$tool_name")"
ARGS_ENV="$(get_env ARGS "")"
LOCK_TITLES="$(get_env LOCK_TITLES 0)"
ANNOTATOR_AUTOSTART="$(get_env ANNOTATOR_AUTOSTART 1)"
REMAIN_ON_EXIT="$(get_env REMAIN_ON_EXIT 1)"
TIPS_PROMPT="$(get_env TIPS_PROMPT "")"
STATE_BASENAME="$(get_env STATE_BASENAME "codexfarm")"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$STATE_BASENAME"
LOGDIR="$STATE_DIR/logs"
DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
HISTORY_BACKEND="${CODEXFARM_HISTORY_BACKEND:-auto}"
DEEP_HISTORY_BIN="${CODEXFARM_DEEP_HISTORY_BIN:-$DATA_HOME/codexfarm/plugins/tmux-deep-history/bin/tmux-deep-history}"
DEEP_HISTORY_PYTHON_BIN=""
DEEP_HISTORY_SEAMLESS_PAGEUP="${CODEXFARM_DEEP_HISTORY_SEAMLESS_PAGEUP:-on}"
SELECTED_HISTORY_BACKEND="legacy"
ANNOTATOR_BIN="$(get_env ANNOTATOR_BIN "$(dirname "$0")/codex-annotator")"
CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
CONFIG_DIR="$CONFIG_HOME/codexfarm"
SYSTEMD_DIR="$CONFIG_HOME/systemd/user"
SYSTEMCTL_BIN="${SYSTEMCTL_BIN:-systemctl}"
AUTOSERVICE_CHOICE_FILE="$STATE_DIR/autoservice_choice"
AUTOSERVICE_REGISTRY="$CONFIG_DIR/farms.tsv"
ANNOTATOR_SESSION_REGISTRY="$STATE_DIR/managed_sessions"
SAVE_BIN="${CODEX_SAVE_BIN:-$(dirname "$0")/codex-save}"
RESTORE_BIN="${CODEX_RESTORE_BIN:-$(dirname "$0")/codex-restore}"

if ! valid_session_name "$SESSION"; then
  echo "Invalid session name: $SESSION" >&2
  exit 2
fi
if ! valid_window_name "$NAME"; then
  echo "Invalid window name: $NAME" >&2
  exit 2
fi
case "$HISTORY_BACKEND" in
  auto|legacy|deep-history) ;;
  *)
    echo "Invalid CODEXFARM_HISTORY_BACKEND: $HISTORY_BACKEND" >&2
    exit 2
    ;;
esac
case "$DEEP_HISTORY_SEAMLESS_PAGEUP" in
  1|true|TRUE|True|yes|YES|Yes|on|ON|On)
    DEEP_HISTORY_SEAMLESS_PAGEUP=on
    ;;
  0|false|FALSE|False|no|NO|No|off|OFF|Off)
    DEEP_HISTORY_SEAMLESS_PAGEUP=off
    ;;
  *)
    echo "Invalid CODEXFARM_DEEP_HISTORY_SEAMLESS_PAGEUP: $DEEP_HISTORY_SEAMLESS_PAGEUP" >&2
    exit 2
    ;;
esac
if [ "$install_autoservice_only" -eq 0 ] && [ ! -d "$DIR" ]; then
  echo "Project directory not found: $DIR" >&2
  exit 2
fi

if [ "$install_autoservice_only" -eq 0 ]; then
  for c in tmux "$CMD"; do
      command -v "$c" >/dev/null || {
          echo "$c not found" >&2
          exit 127
      }
  done
fi

# Fix tmux socket directory permissions if needed
# tmux requires its socket directory to be owned by current user with mode 700
fix_tmux_socket_dir() {
    local tmux_dir
    tmux_dir="/tmp/tmux-$(id -u)"
    if [ -d "$tmux_dir" ]; then
        local owner perms
        # Use a portable stat format across GNU/Linux and macOS/BSD.
        if stat -c '%u' "$tmux_dir" >/dev/null 2>&1; then
            owner=$(stat -c '%u' "$tmux_dir") || return 1
            perms=$(stat -c '%a' "$tmux_dir") || return 1
        elif stat -f '%u' "$tmux_dir" >/dev/null 2>&1; then
            owner=$(stat -f '%u' "$tmux_dir") || return 1
            perms=$(stat -f '%Lp' "$tmux_dir") || return 1
        else
            echo "Error: stat does not support required format options." >&2
            return 1
        fi

        if [ "$owner" != "$(id -u)" ]; then
            echo "Error: $tmux_dir is owned by uid $owner, not you ($(id -u))." >&2
            echo "This can happen after switching users or if another user created it." >&2
            echo "Fix with: sudo rm -rf $tmux_dir" >&2
            return 1
        fi

        if [ "$perms" != "700" ]; then
            echo "Fixing permissions on $tmux_dir (was $perms, setting to 700)..." >&2
            chmod 700 "$tmux_dir" || {
                echo "Failed to fix permissions. Try: chmod 700 $tmux_dir" >&2
                return 1
            }
        fi
    fi
    return 0
}

if [ "$install_autoservice_only" -eq 0 ]; then
  # Attempt to fix tmux socket permissions before any tmux commands.
  fix_tmux_socket_dir || exit 1
fi

# Offer tmux directions for beginners (interactive only and when attaching)
show_tmux_tips() {
  cols=$( (tput cols 2>/dev/null) || echo "${COLUMNS:-80}" )
  lines=$( (tput lines 2>/dev/null) || echo "${LINES:-24}" )
  is_mobile=0
  if [ -n "${TERMUX_VERSION:-}" ] || [ -n "${ANDROID_ROOT:-}" ] || [ "${cols:-80}" -lt 80 ] || [ "${lines:-24}" -lt 24 ]; then
    is_mobile=1
  fi
  echo ""
  echo "tmux quick guide"
  echo "- Prefix is Ctrl-b (hold Ctrl, press b)"
  echo "- Detach session: Prefix then d; reattach: tmux attach -t ${SESSION}"
  echo "- Switch windows: Prefix + n/p (next/prev), or Prefix + w to choose"
  echo "- Switch panes: Prefix + arrow keys; cycle panes: Prefix + o"
  echo "- Zoom a pane full-screen: Prefix + z"
  echo "- Scroll/copy: Prefix + [ then arrows/PageUp; exit with q"
  echo "- Split panes: Prefix + % (vertical) | Prefix + \" (horizontal)"
  if [ "$is_mobile" -eq 1 ]; then
    echo ""
    echo "Mobile tips"
    echo "- Small screen? Use Prefix + z to focus one pane at a time"
    echo "- If content scrolls off-screen: Prefix + [ to enter copy-mode, use arrows/PageUp; q to exit"
    echo "- Consider enabling mouse (per session): :set -g mouse on (then use touch/scroll)"
    echo "- Navigation when keys are limited: use Prefix + w to pick windows, Prefix + o to cycle panes"
  fi
  echo ""
}

install_autoservice_units() {
  register_autoservice_farm
  mkdir -p "$SYSTEMD_DIR"
  cat > "$SYSTEMD_DIR/codex-autosave.service" <<EOF
[Unit]
Description=Codex autosave tmux windows
After=tmux.service

[Service]
Type=oneshot
Environment=XDG_CONFIG_HOME=$CONFIG_HOME
ExecStart=$SAVE_BIN --all-registered

[Install]
WantedBy=default.target
EOF

  cat > "$SYSTEMD_DIR/codex-autosave.timer" <<EOF
[Unit]
Description=Run Codex autosave every hour

[Timer]
OnCalendar=hourly
Persistent=true
Unit=codex-autosave.service

[Install]
WantedBy=timers.target
EOF

  cat > "$SYSTEMD_DIR/codex-autorestore.service" <<EOF
[Unit]
Description=Codex autorestore tmux session on login

[Service]
Type=oneshot
Environment=XDG_CONFIG_HOME=$CONFIG_HOME
ExecStart=$RESTORE_BIN --all-registered

[Install]
WantedBy=default.target
EOF

  if command -v "$SYSTEMCTL_BIN" >/dev/null 2>&1; then
    "$SYSTEMCTL_BIN" --user daemon-reload >/dev/null 2>&1 || true
    "$SYSTEMCTL_BIN" --user enable codex-autosave.timer codex-autorestore.service >/dev/null 2>&1 || true
    "$SYSTEMCTL_BIN" --user start codex-autosave.timer codex-autorestore.service >/dev/null 2>&1 || true
  else
    echo "systemctl not found; services written to $SYSTEMD_DIR but not enabled." >&2
  fi
}

maybe_prompt_autoservice() {
  mkdir -p "$STATE_DIR"
  local choice=""
  local from_file=0
  if [ -f "$AUTOSERVICE_CHOICE_FILE" ]; then
    choice=$(cat "$AUTOSERVICE_CHOICE_FILE")
    from_file=1
  fi

  if [ "$install_autoservice_only" -eq 1 ]; then
    choice="yes"
  fi

  if [ -z "$choice" ]; then
    if [ -n "${CODEX_AUTOSERVICE_CHOICE:-}" ]; then
      choice="$CODEX_AUTOSERVICE_CHOICE"
    elif [ -t 0 ]; then
      echo "Install Codex autosave/autorestore background service?"
      echo "This saves your tmux window manifest hourly and restores it on login."
      echo "Without it, you must run codex-save/codex-restore manually."
      printf "Install now? [y/N] "
      read -r reply || reply=
      case "${reply:-}" in
        y|Y|yes|Yes) choice="yes" ;;
        *) choice="no" ;;
      esac
    else
      return 0
    fi
    echo "$choice" > "$AUTOSERVICE_CHOICE_FILE"
  fi

  case "$choice" in
    y|Y|yes|YES|Yes)
      install_autoservice_units
      echo "yes" > "$AUTOSERVICE_CHOICE_FILE"
      ;;
    *)
      if [ "$install_autoservice_only" -eq 1 ]; then
        echo "Autoservice installation aborted."
      elif [ "$from_file" -eq 0 ]; then
        echo "$choice" > "$AUTOSERVICE_CHOICE_FILE"
        echo "You can enable later with: codex-add --install-autoservice" >&2
      fi
      ;;
  esac
}

# Interactive prompt only if we plan to attach and not already inside tmux
if [ -t 0 ] && [ -z "${TMUX:-}" ] && [ "$detach" -eq 0 ]; then
  OPT_OUT_FILE="$STATE_DIR/no_tips"
  tips_env="$TIPS_PROMPT"
  skip_prompt=0
  force_prompt=0
  if [ -n "$tips_env" ]; then
    case "$tips_env" in
      0|off|false|FALSE|Off) skip_prompt=1 ;;
      1|on|true|TRUE|On) force_prompt=1 ;;
    esac
  fi
  if [ $force_prompt -eq 0 ] && [ -f "$OPT_OUT_FILE" ]; then
    skip_prompt=1
  fi
  if [ $skip_prompt -eq 0 ]; then
    printf 'Need a quick tmux cheat sheet? (y/N) '
    read -r _ans || _ans=
    case "${_ans:-}" in
      y|Y)
        show_tmux_tips
        ;;
    esac
    printf "Don't show this prompt again? (y/N) "
    read -r _never || _never=
    case "${_never:-}" in
      y|Y)
        mkdir -p "$STATE_DIR"
        : > "$OPT_OUT_FILE"
        echo "Okay, disabling future tmux tip prompts."
        ;;
    esac
  fi
fi

start_status_annotator() {
  false_value "$ANNOTATOR_AUTOSTART" && return
  if [ -x "$ANNOTATOR_BIN" ]; then
    # Runs detached; helper enforces a single instance via its lockfile.
    ( "$ANNOTATOR_BIN" >/dev/null 2>&1 || true ) &
  fi
}

configure_history_backend() {
  local resolved_bin resolved_python deep_root installed_root install_error
  local desired_integration installed_integration table
  SELECTED_HISTORY_BACKEND="legacy"
  if [ "$HISTORY_BACKEND" = "legacy" ]; then
    # The plugin's hooks are global. Explicit legacy mode must disable them
    # before creating the pane or they can claim tmux's single output pipe.
    tmux set-option -gq '@deep-history-auto-start' off >/dev/null 2>&1 || true
    return 0
  fi

  if ! resolved_bin="$(resolve_executable "$DEEP_HISTORY_BIN")"; then
    if [ "$HISTORY_BACKEND" = "deep-history" ]; then
      echo "warning: tmux-deep-history is unavailable; using legacy pane logging" >&2
    else
      echo "warning: tmux-deep-history is not installed; using legacy pane logging" >&2
      echo "warning: rerun setup.sh --with-deep-history, or set CODEXFARM_HISTORY_BACKEND=legacy to opt out" >&2
    fi
    return 0
  fi

  DEEP_HISTORY_BIN="$resolved_bin"
  if ! resolved_python="$(resolve_deep_history_python)"; then
    echo "warning: tmux-deep-history requires Python 3.10 or newer; using legacy pane logging" >&2
    return 0
  fi
  DEEP_HISTORY_PYTHON_BIN="$resolved_python"
  if ! tmux set-option -gq '@deep-history-auto-start' off \
    || ! tmux set-option -gq '@deep-history-seamless-pageup' "$DEEP_HISTORY_SEAMLESS_PAGEUP" \
    || ! tmux set-environment -g TMUX_DEEP_HISTORY_PYTHON "$DEEP_HISTORY_PYTHON_BIN" \
    || ! tmux set-environment -t "$SESSION" TMUX_DEEP_HISTORY_PYTHON "$DEEP_HISTORY_PYTHON_BIN"; then
    echo "warning: unable to configure tmux-deep-history; using legacy pane logging" >&2
    return 0
  fi
  deep_root="$(cd "$(dirname "$DEEP_HISTORY_BIN")/.." && pwd)"
  installed_root="$(tmux show-options -gqv '@deep-history-root' 2>/dev/null || true)"
  # Bump this marker whenever farm-managed plugin bindings/options change.
  desired_integration="2:$DEEP_HISTORY_SEAMLESS_PAGEUP"
  installed_integration="$(tmux show-options -gqv '@codexfarm-deep-history-integration' 2>/dev/null || true)"
  if [ "$installed_root" != "$deep_root" ] || [ "$installed_integration" != "$desired_integration" ]; then
    if ! install_error=$(TMUX_DEEP_HISTORY_PYTHON="$DEEP_HISTORY_PYTHON_BIN" \
      "$DEEP_HISTORY_BIN" install 2>&1); then
      echo "warning: unable to initialize tmux-deep-history; using legacy pane logging" >&2
      [ -z "$install_error" ] || printf '%s\n' "$install_error" >&2
      return 0
    fi
    if [ "$DEEP_HISTORY_SEAMLESS_PAGEUP" = "off" ]; then
      for table in copy-mode copy-mode-vi; do
        tmux bind-key -T "$table" PPage send-keys -X page-up >/dev/null 2>&1 || true
      done
    fi
    tmux set-option -gq '@codexfarm-deep-history-integration' "$desired_integration" \
      >/dev/null 2>&1 || true
  fi
  SELECTED_HISTORY_BACKEND="deep-history"
}

attach_legacy_log_pipe() {
  local pipe_error quoted_logfile
  printf -v quoted_logfile '%q' "$LOGFILE"
  if ! pipe_error=$(tmux pipe-pane -o -t "$SESSION:$WIN" "cat >> $quoted_logfile" 2>&1); then
    if [ -n "$pipe_error" ]; then
      echo "warning: unable to attach log pipe; pane may have exited already: $pipe_error" >&2
    else
      echo "warning: unable to attach log pipe; pane may have exited already" >&2
    fi
  fi
}

attach_history_logging() {
  local start_error
  if [ "$SELECTED_HISTORY_BACKEND" = "deep-history" ]; then
    if start_error=$(
      TMUX_DEEP_HISTORY_PYTHON="$DEEP_HISTORY_PYTHON_BIN" \
        "$DEEP_HISTORY_BIN" start -t "$SESSION:$WIN" --mirror-output "$LOGFILE" 2>&1
    ); then
      return 0
    fi
    echo "warning: tmux-deep-history could not start; falling back to legacy pane logging" >&2
    [ -z "$start_error" ] || printf '%s\n' "$start_error" >&2
    SELECTED_HISTORY_BACKEND="legacy"
  fi
  attach_legacy_log_pipe
}

enable_history_auto_start() {
  local pane_states
  [ "$SELECTED_HISTORY_BACKEND" = "deep-history" ] || return 0
  if ! tmux set-option -gq '@deep-history-auto-start' on; then
    echo "warning: unable to enable automatic deep-history recording" >&2
    return 0
  fi
  pane_states="$(tmux list-panes -a -F '#{pane_pipe}:#{@deep-history-owned}' 2>/dev/null || true)"
  if ! printf '%s\n' "$pane_states" | grep -q '^0:'; then
    return 0
  fi
  # The plugin's hooks are global, so bring every existing tmux pane under the
  # same policy too. This can be slow with many panes, so do it asynchronously;
  # an existing foreign pipe is reported and left untouched.
  (
    TMUX_DEEP_HISTORY_PYTHON="$DEEP_HISTORY_PYTHON_BIN" \
      "$DEEP_HISTORY_BIN" start-all >/dev/null 2>&1 || true
  ) &
}

remain_on_exit_enabled() {
  case "${REMAIN_ON_EXIT:-1}" in
    0|false|FALSE|False|off|OFF|Off|no|NO|No)
      return 1
      ;;
    *)
      return 0
      ;;
  esac
}

# Set up the private compatibility-log destination before starting the pane.
mkdir -p "$LOGDIR"
chmod 700 "$STATE_DIR" "$LOGDIR" 2>/dev/null || true

maybe_prompt_autoservice
if [ "$install_autoservice_only" -eq 1 ]; then
  exit 0
fi

STAMP=$(date +%Y%m%d-%H%M%S)
log_seed=$(mktemp "$LOGDIR/.codexfarm-log.XXXXXX")
log_token="${log_seed##*.codexfarm-log.}"
LOGFILE="$LOGDIR/$(safe_name "$NAME")_${STAMP}_${log_token}.log"
mv "$log_seed" "$LOGFILE"
chmod 600 "$LOGFILE" 2>/dev/null || true

# Create session if it doesn't exist
tmux has-session -t "$SESSION" 2>/dev/null || tmux new-session -d -s "$SESSION" -n home

# Deep history must be configured before the managed window is created so its
# global hooks cannot race the farm for tmux's single pane output pipe.
configure_history_backend

# Start annotator after ensuring tmux is available
register_managed_session
start_status_annotator

# Create new window and start Codex
printf -v CMDLINE '%q' "$CMD"
if [ -n "$ARGS_ENV" ]; then
  CMDLINE="$CMDLINE $ARGS_ENV"
fi
if [ ${#tool_args[@]} -gt 0 ]; then
  for tool_arg in "${tool_args[@]}"; do
    printf -v quoted_arg '%q' "$tool_arg"
    CMDLINE="$CMDLINE $quoted_arg"
  done
fi
WINDOW_CMDLINE="$CMDLINE"
if remain_on_exit_enabled; then
  WINDOW_CMDLINE="tmux set-window-option -q remain-on-exit on >/dev/null 2>&1 || true; exec $CMDLINE"
fi

if [ "$SELECTED_HISTORY_BACKEND" = "deep-history" ]; then
  WIN=$(tmux new-window -t "$SESSION" -P -F "#{window_index}" -n "$NAME" -c "$DIR" \
    -e "TMUX_DEEP_HISTORY_PYTHON=$DEEP_HISTORY_PYTHON_BIN" "$WINDOW_CMDLINE")
else
  WIN=$(tmux new-window -t "$SESSION" -P -F "#{window_index}" -n "$NAME" -c "$DIR" "$WINDOW_CMDLINE")
fi

if remain_on_exit_enabled; then
  tmux set-window-option -t "$SESSION:$WIN" remain-on-exit on >/dev/null 2>&1 || true
fi

# Keep tmux from overwriting the chosen window title unless explicitly requested
if [ "${LOCK_TITLES:-1}" -eq 1 ]; then
  tmux set-option -t "$SESSION" allow-rename off >/dev/null 2>&1 || true
  tmux set-option -t "$SESSION" automatic-rename off >/dev/null 2>&1 || true
  tmux set-window-option -t "$SESSION:$WIN" allow-rename off >/dev/null 2>&1 || true
  tmux set-window-option -t "$SESSION:$WIN" automatic-rename off >/dev/null 2>&1 || true
  tmux rename-window -t "$SESSION:$WIN" "$NAME" >/dev/null 2>&1 || true
fi

# Attach exactly one pane pipe. Deep history owns it when available and mirrors
# its raw stream to LOGFILE so codex-watch remains backward compatible.
attach_history_logging
enable_history_auto_start

# Link to board session if it exists
tmux has-session -t "$BOARD_SESSION" 2>/dev/null && tmux link-window -s "$SESSION:$WIN" -t "$BOARD_SESSION"

# Attach or switch to window unless detaching
if [ "$detach" -eq 0 ]; then
  if [ -n "${TMUX:-}" ]; then 
      tmux select-window -t "$SESSION:$WIN"
  else 
      tmux attach -t "$SESSION"
  fi
fi

printf 'Started %s in %s:%s\nHistory backend: %s\nLogging to %s\n' \
  "$CMD" "$SESSION" "$WIN" "$SELECTED_HISTORY_BACKEND" "$LOGFILE"
