#!/usr/bin/env bash
set -euo pipefail

# Watch all Codex logs in a consolidated view
# Modes:
#   - auto (default): use multitail when terminal is large enough; otherwise tail
#   - multitail: force multitail
#   - tail: force simple tail

DEFAULT_SESSION="codexfarm"
SESSION="${CODEX_SESSION:-$DEFAULT_SESSION}"
STATE_BASENAME="${CODEX_STATE_BASENAME:-codexfarm}"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/$STATE_BASENAME"
LOGDIR="$STATE_DIR/logs"
mode="${CODEX_WATCH_MODE:-auto}"
show_help=0
positionals=()

while (( "$#" )); do
  case "${1:-}" in
    -s|--simple) mode="tail"; shift ;;
    --session)
      if [ "$#" -lt 2 ]; then
        echo "Missing value for $1" >&2
        exit 2
      fi
      SESSION="$2"
      shift 2
      ;;
    -m|--mode)
      if [ "$#" -lt 2 ]; then
        echo "Missing value for $1" >&2
        exit 2
      fi
      mode="$2"
      shift 2
      ;;
    -h|--help)
      show_help=1
      shift
      ;;
    --)
      shift
      while (( "$#" )); do
        positionals+=("$1")
        shift
      done
      break
      ;;
    -*) echo "Unknown option: $1" >&2; exit 2 ;;
    *)
      positionals+=("$1")
      shift
      ;;
  esac
done

case "$mode" in
  auto|multitail|tail) ;;
  *)
    echo "Invalid mode: $mode" >&2
    exit 2
    ;;
esac

if [ ${#positionals[@]} -gt 0 ]; then
  echo "Unexpected argument: ${positionals[0]}" >&2
  exit 2
fi

if [ "$show_help" -eq 1 ]; then
      cat <<EOF
Usage: $(basename "$0") [--session SESSION] [--simple] [--mode auto|multitail|tail]

Watches log files in $LOGDIR
- auto (default): multitail when terminal is big enough, else tail
- tail: simpler output, best for small/phone screens
- multitail: force multitail (may error on very small screens)

Log files are discovered once at startup. Restart to see new files.
EOF
      exit 0
fi

mkdir -p "$LOGDIR"

# Find all log files once at startup.
shopt -s nullglob
files=( "$LOGDIR"/*.log )

if [ ${#files[@]} -eq 0 ]; then
    echo "No logs yet in $LOGDIR"
    echo "Start some Codex instances with 'codex-add' first"
    exit 0
fi

# Offer tmux directions for beginners (interactive only)
show_tmux_tips() {
  cols=$( (tput cols 2>/dev/null) || echo "${COLUMNS:-80}" )
  lines=$( (tput lines 2>/dev/null) || echo "${LINES:-24}" )
  is_mobile=0
  if [ -n "${TERMUX_VERSION:-}" ] || [ -n "${ANDROID_ROOT:-}" ] || [ "${cols:-80}" -lt 80 ] || [ "${lines:-24}" -lt 24 ]; then
    is_mobile=1
  fi
  echo ""
  echo "tmux quick guide"
  echo "- Prefix is Ctrl-b (hold Ctrl, press b)"
  echo "- Detach session: Prefix then d; reattach: tmux attach -t ${SESSION}"
  echo "- Switch windows: Prefix + n/p (next/prev), or Prefix + w to choose"
  echo "- Switch panes: Prefix + arrow keys; cycle panes: Prefix + o"
  echo "- Zoom a pane full-screen: Prefix + z"
  echo "- Scroll/copy: Prefix + [ then arrows/PageUp; exit with q"
  echo "- Split panes: Prefix + % (vertical) | Prefix + \" (horizontal)"
  if [ "$is_mobile" -eq 1 ]; then
    echo ""
    echo "Mobile tips"
    echo "- Small screen? Use Prefix + z to focus one pane at a time"
    echo "- If content scrolls off-screen: Prefix + [ to enter copy-mode, use arrows/PageUp; q to exit"
    echo "- Consider enabling mouse (per session): :set -g mouse on (then use touch/scroll)"
    echo "- Navigation when keys are limited: use Prefix + w to pick windows, Prefix + o to cycle panes"
  fi
  echo ""
}

OPT_OUT_FILE="$STATE_DIR/no_tips"
tips_env="${CODEX_TIPS_PROMPT:-}"
skip_prompt=0
force_prompt=0
if [ -n "$tips_env" ]; then
  case "$tips_env" in
    0|off|false|FALSE|Off) skip_prompt=1 ;;
    1|on|true|TRUE|On) force_prompt=1 ;;
  esac
fi
if [ -t 0 ]; then
  if [ $force_prompt -eq 0 ] && [ -f "$OPT_OUT_FILE" ]; then
    skip_prompt=1
  fi
  if [ $skip_prompt -eq 0 ]; then
    printf 'Need a quick tmux cheat sheet? (y/N) '
    read -r _ans || _ans=
    case "${_ans:-}" in
      y|Y) show_tmux_tips ;;
    esac
    printf "Don't show this prompt again? (y/N) "
    read -r _never || _never=
    case "${_never:-}" in
      y|Y)
        mkdir -p "$STATE_DIR"
        : > "$OPT_OUT_FILE"
        echo "Okay, disabling future tmux tip prompts."
        ;;
    esac
  fi
fi

echo "Watching ${#files[@]} log file(s) in $LOGDIR (mode: $mode)"

# Terminal size detection
cols=$( (tput cols 2>/dev/null) || echo "${COLUMNS:-80}" )
lines=$( (tput lines 2>/dev/null) || echo "${LINES:-24}" )
small_term=0
if [ "${cols:-80}" -lt 60 ] || [ "${lines:-24}" -lt 20 ]; then
  small_term=1
fi

pick_tail() {
  # Prefer less if available for scrollback; fall back to plain tail
  if command -v less >/dev/null; then
    echo "Using tail | less -SR +F (compact)" >&2
    tail -n 200 -F "${files[@]}" | less -SR +F
  else
    exec tail -n 200 -F "${files[@]}"
  fi
}

case "$mode" in
  tail)
    pick_tail
    ;;
  multitail)
    if ! command -v multitail >/dev/null; then
      echo "multitail not found; falling back to tail" >&2
      pick_tail
    else
      multitail -n 200 "${files[@]}" || { echo "multitail exited; falling back to tail" >&2; pick_tail; }
    fi
    ;;
  auto)
    if command -v multitail >/dev/null && [ "$small_term" -eq 0 ]; then
      multitail -n 200 "${files[@]}" || { echo "multitail exited; falling back to tail" >&2; pick_tail; }
    else
      [ "$small_term" -eq 1 ] && echo "Terminal small; using simple mode" >&2
      [ ! "$(command -v multitail || true)" ] && echo "multitail not found; using simple mode" >&2
      pick_tail
    fi
    ;;
esac
