#!/usr/bin/env python3
"""Verify, privately extract, copy or explicitly snapshot workspace recovery data."""

import sys
from pathlib import Path

for root in (Path(__file__).resolve().parent.parent, Path(__file__).resolve().parent):
    if (root / "codex_looper").is_dir():
        sys.path.insert(0, str(root))
        break

from codex_looper.recovery import main  # noqa: E402

if __name__ == "__main__":
    raise SystemExit(main())
