#!/usr/bin/env bash
set -euo pipefail

# Restore Codex windows from a manifest file created by codex-save
# Usage: codex-restore [-a] [-f] [manifest-path]
#  -a, --attach   Attach/switch to session after restore
#  -f, --force    Recreate windows if names already exist

script_name=$(basename "${0:-codex-restore}")
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tool_name="${CODEX_TOOL_NAME:-codex}"
case "$script_name" in
  claude-restore) tool_name="${CODEX_TOOL_NAME:-claude}" ;;
  gemini-restore) tool_name="${CODEX_TOOL_NAME:-gemini}" ;;
esac
ADD_BIN="${CODEX_ADD_BIN:-$SCRIPT_DIR/codex-add}"

usage() {
  cat <<EOF
Usage: $script_name [-a|--attach] [-f|--force] [--all-registered] [manifest-path]

Restore tmux farm windows from a trusted executable manifest.
EOF
}

trim_command_field() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [ "${#value}" -ge 2 ]; then
    case "$value" in
      \"*\")
        value="${value%\"}"
        value="${value#\"}"
        ;;
      \'*\')
        value="${value%\'}"
        value="${value#\'}"
        ;;
    esac
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
  fi
  printf '%s' "$value"
}

strip_status_prefix() {
  local value="$1"
  local old match
  while :; do
    old="$value"
    case "$value" in
      "*READY* "*) value="${value#\*READY\* }" ;;
      "*RUN* "*) value="${value#\*RUN\* }" ;;
      "*ERR* "*) value="${value#\*ERR\* }" ;;
    esac
    if [[ "$value" =~ ^\*[0-9]+(\.[0-9]+)?\+MB\*\*[[:space:]]* ]]; then
      match="${BASH_REMATCH[0]}"
      value="${value:${#match}}"
    fi
    [ "$value" = "$old" ] && break
  done
  printf '%s' "$value"
}

existing_window_targets() {
  local session="$1"
  local wanted_name="$2"
  local line target name base_name stable_name

  while IFS= read -r line; do
    [ -z "$line" ] && continue
    if [[ "$line" == *$'\t'* ]]; then
      target="${line%%$'\t'*}"
      name="${line#*$'\t'}"
    else
      target="$line"
      name="$line"
    fi
    stable_name="$(
      tmux show-options -p -v -t "$target.0" @codexfarm_name 2>/dev/null || true
    )"
    if [ -n "$stable_name" ]; then
      base_name="$stable_name"
    else
      base_name="$(strip_status_prefix "$name")"
    fi
    if [ "$base_name" = "$wanted_name" ]; then
      printf '%s\n' "$target"
    fi
  done < <(tmux list-windows -t "$session" -F $'#{window_id}\t#{window_name}')
}

existing_window_target() {
  local session="$1"
  local wanted_name="$2"
  local wanted_occurrence="${3:-1}"
  local target count=0
  while IFS= read -r target; do
    [ -n "$target" ] || continue
    count=$((count + 1))
    if [ "$count" -eq "$wanted_occurrence" ]; then
      printf '%s' "$target"
      return 0
    fi
  done < <(existing_window_targets "$session" "$wanted_name")
  return 1
}

valid_session_id() {
  [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
}

tool_from_command() {
  local value
  value="$(trim_command_field "$1")"
  local first="${value%%[[:space:]]*}"
  local base="${first##*/}"
  case "$base" in
    codex|claude|gemini)
      printf '%s' "$base"
      return 0
      ;;
  esac
  return 1
}

command_args_after_tool() {
  local value
  value="$(trim_command_field "$1")"
  local first="${value%%[[:space:]]*}"
  if [ "$first" = "$value" ]; then
    return 0
  fi
  value="${value#"$first"}"
  value="${value#"${value%%[![:space:]]*}"}"
  printf '%s' "$value"
}

default_resume_args_for_tool() {
  case "$1" in
    codex) printf '%s' "resume --last" ;;
    claude) printf '%s' "--continue" ;;
    gemini) printf '%s' "--resume latest" ;;
  esac
}

normalize_restore_command() {
  local raw_cmd="$1"
  local raw_args="$2"
  local parsed_tool parsed_args

  RESTORE_CMD="$(trim_command_field "${raw_cmd:-}")"
  RESTORE_ARGS="${raw_args:-}"

  case "$RESTORE_CMD" in
    sh|bash|zsh|'')
      RESTORE_CMD="${CODEX_CMD:-$tool_name}"
      ;;
  esac

  parsed_tool="$(tool_from_command "$RESTORE_CMD" || true)"
  if [ -n "$parsed_tool" ]; then
    parsed_args="$(command_args_after_tool "$RESTORE_CMD")"
    RESTORE_CMD="$parsed_tool"
    if [ -z "$RESTORE_ARGS" ]; then
      RESTORE_ARGS="$parsed_args"
    fi
  fi

  if [ -z "$RESTORE_ARGS" ]; then
    RESTORE_ARGS="$(default_resume_args_for_tool "$RESTORE_CMD")"
  fi

  if [ -z "$RESTORE_ARGS" ]; then
    RESTORE_ARGS="${CODEX_ARGS:-}"
  fi
}

exact_session_id_from_restore() {
  local command="$1"
  local args="$2"
  local values=()
  read -r -a values <<< "$args"
  [ "${#values[@]}" -eq 2 ] || return 1
  case "$command:${values[0]}" in
    codex:resume|claude:--resume|gemini:--resume) ;;
    *) return 1 ;;
  esac
  valid_session_id "${values[1]}" || return 1
  printf '%s' "${values[1]}"
}

next_name_occurrence() {
  local wanted="$1"
  local index
  for index in "${!seen_names[@]}"; do
    if [ "${seen_names[$index]}" = "$wanted" ]; then
      seen_counts[$index]=$((seen_counts[$index] + 1))
      window_occurrence="${seen_counts[$index]}"
      return
    fi
  done
  seen_names+=("$wanted")
  seen_counts+=(1)
  window_occurrence=1
}

name_was_seen() {
  local wanted="$1"
  local value
  for value in "${force_names[@]}"; do
    [ "$value" = "$wanted" ] && return 0
  done
  return 1
}

DEFAULT_SESSION="codexfarm"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/codexfarm"
AUTOSERVICE_REGISTRY="$CONFIG_DIR/farms.tsv"

safe_name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

default_manifest_path_for_session() {
  local session="$1"
  if [ "$session" = "$DEFAULT_SESSION" ]; then
    printf '%s/manifest.tsv' "$CONFIG_DIR"
  else
    printf '%s/manifests/%s.tsv' "$CONFIG_DIR" "$(safe_name "$session")"
  fi
}

attach_to_session() {
  local session="$1"
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$session"
  else
    tmux attach -t "$session"
  fi
}

restore_all_registered() {
  local attach_requested="$1"
  local force_requested="$2"
  local session manifest status count first_session
  status=0
  count=0
  first_session=""

  if [ ! -f "$AUTOSERVICE_REGISTRY" ]; then
    echo "No registered farms found at $AUTOSERVICE_REGISTRY"
    return 0
  fi

  while IFS=$'\t' read -r session manifest _rest || [ -n "${session:-}" ]; do
    case "${session:-}" in
      ""|"session"|\#*) continue ;;
    esac
    if [ -z "$first_session" ]; then
      first_session="$session"
    fi
    if [ -z "${manifest:-}" ]; then
      manifest="$(default_manifest_path_for_session "$session")"
    fi

    restore_args=()
    if [ "$force_requested" -eq 1 ]; then
      restore_args+=("--force")
    fi
    restore_args+=("$manifest")
    if CODEX_SESSION="$session" "$0" "${restore_args[@]}"; then
      count=$((count + 1))
    else
      status=1
    fi
  done < "$AUTOSERVICE_REGISTRY"

  if [ "$attach_requested" -eq 1 ] && [ -n "$first_session" ]; then
    attach_to_session "$first_session"
  fi
  echo "Restored $count registered farm(s)"
  return "$status"
}

attach=0
force=0
all_registered=0
args_pos=()
while (( "$#" )); do
  case "${1:-}" in
    -a|--attach) attach=1; shift ;;
    -f|--force) force=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --all-registered) all_registered=1; shift ;;
    --) shift; while (( "$#" )); do args_pos+=("$1"); shift; done ;;
    -*) echo "Unknown option: $1" >&2; exit 2 ;;
    *) args_pos+=("$1"); shift ;;
  esac
done

if [ "${#args_pos[@]}" -gt 1 ]; then
  echo "Unexpected argument: ${args_pos[1]}" >&2
  exit 2
fi

if [ "$all_registered" -eq 1 ] && [ "${#args_pos[@]}" -gt 0 ]; then
  echo "--all-registered cannot be combined with a manifest path" >&2
  exit 2
fi

SESSION="${CODEX_SESSION:-$DEFAULT_SESSION}"
MANIFEST_PATH="${args_pos[0]:-$(default_manifest_path_for_session "$SESSION")}"

if [ "$all_registered" -eq 1 ]; then
  if ! command -v tmux >/dev/null; then
    echo "tmux not found" >&2
    exit 127
  fi
  restore_all_registered "$attach" "$force"
  exit $?
fi

if [ ! -f "$MANIFEST_PATH" ]; then
  echo "Manifest not found: $MANIFEST_PATH" >&2
  exit 1
fi

IFS= read -r manifest_header < "$MANIFEST_PATH" || manifest_header=""
if [ "$manifest_header" != $'name\tdir\tcmd\targs' ]; then
  echo "Malformed manifest header: $MANIFEST_PATH" >&2
  exit 2
fi

if ! command -v tmux >/dev/null; then
  echo "tmux not found" >&2
  exit 127
fi

# Ensure session exists
tmux has-session -t "$SESSION" 2>/dev/null || tmux new-session -d -s "$SESSION" -n home

force_names=()
if [ "$force" -eq 1 ]; then
  {
    IFS= read -r _header || true
    while IFS=$'\t' read -r name _dir _cmd _args || [ -n "${name:-}" ]; do
      [ -n "${name:-}" ] || continue
      if name_was_seen "$name"; then
        continue
      fi
      force_names+=("$name")
      while IFS= read -r existing_target; do
        [ -n "$existing_target" ] || continue
        if ! tmux kill-window -t "$existing_target"; then
          echo "Unable to remove existing window '$name' during force restore." >&2
          exit 1
        fi
      done < <(existing_window_targets "$SESSION" "$name")
    done
  } < "$MANIFEST_PATH"
fi

# Read manifest; skip header
seen_names=()
seen_counts=()
{
  IFS= read -r _header || true
  while IFS=$'\t' read -r name dir cmd args || [ -n "${name:-}" ]; do
    [ -z "${name:-}" ] && continue
    next_name_occurrence "$name"
    restore_dir="${dir:-$HOME}"
    if [ ! -d "$restore_dir" ]; then
      echo "Warning: saved directory not found, using HOME: $restore_dir" >&2
      restore_dir="$HOME"
    fi
    if [ "$force" -eq 0 ]; then
      existing_target="$(
        existing_window_target "$SESSION" "$name" "$window_occurrence" || true
      )"
      if [ -n "$existing_target" ]; then
        echo "Skipping existing window: $name"
        continue
      fi
    fi
    normalize_restore_command "${cmd:-}" "${args:-}"
    restore_provider="$tool_name"
    case "$RESTORE_CMD" in
      codex|claude|gemini) restore_provider="$RESTORE_CMD" ;;
    esac
    CODEX_TOOL_NAME="$restore_provider" \
      CODEX_NAME="$name" \
      CODEX_CMD="$RESTORE_CMD" \
      CODEX_ARGS="$RESTORE_ARGS" \
      "$ADD_BIN" -d "$restore_dir"

    exact_session_id="$(
      exact_session_id_from_restore "$RESTORE_CMD" "$RESTORE_ARGS" || true
    )"
    if [ -n "$exact_session_id" ]; then
      created_target="$(
        existing_window_target "$SESSION" "$name" "$window_occurrence" || true
      )"
      if [ -n "$created_target" ]; then
        if ! tmux set-option -p -t "$created_target.0" \
          @codexfarm_provider "$RESTORE_CMD" >/dev/null 2>&1 \
          || ! tmux set-option -p -t "$created_target.0" \
            @codexfarm_session_source restore >/dev/null 2>&1 \
          || ! tmux set-option -p -t "$created_target.0" \
            @codexfarm_session_id "$exact_session_id" >/dev/null 2>&1
        then
          echo "Warning: unable to seed exact session metadata for window: $name" >&2
        fi
      fi
    fi
  done
} < "$MANIFEST_PATH"

if [ "$attach" -eq 1 ]; then
  attach_to_session "$SESSION"
fi

echo "Restore complete from $MANIFEST_PATH"
