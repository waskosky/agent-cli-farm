#!/usr/bin/env bash
set -euo pipefail

# Restore Codex windows from a manifest file created by codex-save
# Usage: codex-restore [-a] [-f] [manifest-path]
#  -a, --attach   Attach/switch to session after restore
#  -f, --force    Recreate windows if names already exist

script_name=$(basename "${0:-codex-restore}")
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tool_name="${CODEX_TOOL_NAME:-codex}"
case "$script_name" in
  claude-restore) tool_name="${CODEX_TOOL_NAME:-claude}" ;;
  gemini-restore) tool_name="${CODEX_TOOL_NAME:-gemini}" ;;
esac
ADD_BIN="${CODEX_ADD_BIN:-$SCRIPT_DIR/codex-add}"

trim_command_field() {
  local value="$1"
  value="${value#"${value%%[![:space:]]*}"}"
  value="${value%"${value##*[![:space:]]}"}"
  if [ "${#value}" -ge 2 ]; then
    case "$value" in
      \"*\")
        value="${value%\"}"
        value="${value#\"}"
        ;;
      \'*\')
        value="${value%\'}"
        value="${value#\'}"
        ;;
    esac
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
  fi
  printf '%s' "$value"
}

strip_status_prefix() {
  local value="$1"
  case "$value" in
    "*READY* "*) value="${value#\*READY\* }" ;;
    "*RUN* "*) value="${value#\*RUN\* }" ;;
    "*ERR* "*) value="${value#\*ERR\* }" ;;
  esac
  printf '%s' "$value"
}

existing_window_target() {
  local session="$1"
  local wanted_name="$2"
  local line target name base_name

  while IFS= read -r line; do
    [ -z "$line" ] && continue
    if [[ "$line" == *$'\t'* ]]; then
      target="${line%%$'\t'*}"
      name="${line#*$'\t'}"
    else
      target="$line"
      name="$line"
    fi
    base_name="$(strip_status_prefix "$name")"
    if [ "$base_name" = "$wanted_name" ]; then
      printf '%s' "$target"
      return 0
    fi
  done < <(tmux list-windows -t "$session" -F '#{window_id}\t#{window_name}')

  return 1
}

tool_from_command() {
  local value
  value="$(trim_command_field "$1")"
  local first="${value%%[[:space:]]*}"
  local base="${first##*/}"
  case "$base" in
    codex|claude|gemini)
      printf '%s' "$base"
      return 0
      ;;
  esac
  return 1
}

command_args_after_tool() {
  local value
  value="$(trim_command_field "$1")"
  local first="${value%%[[:space:]]*}"
  if [ "$first" = "$value" ]; then
    return 0
  fi
  value="${value#"$first"}"
  value="${value#"${value%%[![:space:]]*}"}"
  printf '%s' "$value"
}

default_resume_args_for_tool() {
  case "$1" in
    codex) printf '%s' "resume --last" ;;
    claude) printf '%s' "--continue" ;;
    gemini) printf '%s' "--resume latest" ;;
  esac
}

normalize_restore_command() {
  local raw_cmd="$1"
  local raw_args="$2"
  local parsed_tool parsed_args

  RESTORE_CMD="$(trim_command_field "${raw_cmd:-}")"
  RESTORE_ARGS="${raw_args:-}"

  case "$RESTORE_CMD" in
    sh|bash|zsh|'')
      RESTORE_CMD="${CODEX_CMD:-$tool_name}"
      ;;
  esac

  parsed_tool="$(tool_from_command "$RESTORE_CMD" || true)"
  if [ -n "$parsed_tool" ]; then
    parsed_args="$(command_args_after_tool "$RESTORE_CMD")"
    RESTORE_CMD="$parsed_tool"
    if [ -z "$RESTORE_ARGS" ]; then
      RESTORE_ARGS="$parsed_args"
    fi
  fi

  if [ -z "$RESTORE_ARGS" ]; then
    RESTORE_ARGS="$(default_resume_args_for_tool "$RESTORE_CMD")"
  fi

  if [ -z "$RESTORE_ARGS" ]; then
    RESTORE_ARGS="${CODEX_ARGS:-}"
  fi
}

DEFAULT_SESSION="codexfarm"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/codexfarm"
AUTOSERVICE_REGISTRY="$CONFIG_DIR/farms.tsv"

safe_name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

default_manifest_path_for_session() {
  local session="$1"
  if [ "$session" = "$DEFAULT_SESSION" ]; then
    printf '%s/manifest.tsv' "$CONFIG_DIR"
  else
    printf '%s/manifests/%s.tsv' "$CONFIG_DIR" "$(safe_name "$session")"
  fi
}

attach_to_session() {
  local session="$1"
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$session"
  else
    tmux attach -t "$session"
  fi
}

restore_all_registered() {
  local attach_requested="$1"
  local force_requested="$2"
  local session manifest status count first_session
  status=0
  count=0
  first_session=""

  if [ ! -f "$AUTOSERVICE_REGISTRY" ]; then
    echo "No registered farms found at $AUTOSERVICE_REGISTRY"
    return 0
  fi

  while IFS=$'\t' read -r session manifest _rest || [ -n "${session:-}" ]; do
    case "${session:-}" in
      ""|"session"|\#*) continue ;;
    esac
    if [ -z "$first_session" ]; then
      first_session="$session"
    fi
    if [ -z "${manifest:-}" ]; then
      manifest="$(default_manifest_path_for_session "$session")"
    fi

    restore_args=()
    if [ "$force_requested" -eq 1 ]; then
      restore_args+=("--force")
    fi
    if CODEX_SESSION="$session" "$0" "${restore_args[@]}" "$manifest"; then
      count=$((count + 1))
    else
      status=1
    fi
  done < "$AUTOSERVICE_REGISTRY"

  if [ "$attach_requested" -eq 1 ] && [ -n "$first_session" ]; then
    attach_to_session "$first_session"
  fi
  echo "Restored $count registered farm(s)"
  return "$status"
}

attach=0
force=0
all_registered=0
args_pos=()
while (( "$#" )); do
  case "${1:-}" in
    -a|--attach) attach=1; shift ;;
    -f|--force) force=1; shift ;;
    --all-registered) all_registered=1; shift ;;
    --) shift; while (( "$#" )); do args_pos+=("$1"); shift; done ;;
    -*) echo "Unknown option: $1" >&2; exit 2 ;;
    *) args_pos+=("$1"); shift ;;
  esac
done

SESSION="${CODEX_SESSION:-$DEFAULT_SESSION}"
MANIFEST_PATH="${args_pos[0]:-$(default_manifest_path_for_session "$SESSION")}"

if ! command -v tmux >/dev/null; then
  echo "tmux not found" >&2
  exit 127
fi

if [ "$all_registered" -eq 1 ]; then
  restore_all_registered "$attach" "$force"
  exit $?
fi

if [ ! -f "$MANIFEST_PATH" ]; then
  echo "Manifest not found: $MANIFEST_PATH" >&2
  exit 1
fi

# Ensure session exists
tmux has-session -t "$SESSION" 2>/dev/null || tmux new-session -d -s "$SESSION" -n home

# Read manifest; skip header
{ read -r _header || true; cat; } < "$MANIFEST_PATH" | while IFS=$'\t' read -r name dir cmd args || [ -n "${name:-}" ]; do
  [ -z "${name:-}" ] && continue
  # Skip if window exists and not forcing
  existing_target="$(existing_window_target "$SESSION" "$name" || true)"
  if [ -n "$existing_target" ]; then
    if [ "$force" -eq 1 ]; then
      tmux kill-window -t "$existing_target" || true
    else
      echo "Skipping existing window: $name"
      continue
    fi
  fi
  normalize_restore_command "${cmd:-}" "${args:-}"
  CODEX_NAME="$name" CODEX_CMD="$RESTORE_CMD" CODEX_ARGS="$RESTORE_ARGS" "$ADD_BIN" -d "${dir:-$HOME}"
done

if [ "$attach" -eq 1 ]; then
  attach_to_session "$SESSION"
fi

echo "Restore complete from $MANIFEST_PATH"
