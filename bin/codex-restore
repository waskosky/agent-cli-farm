#!/usr/bin/env bash
set -euo pipefail

# Restore Codex windows from a manifest file created by codex-save
# Usage: codex-restore [-a] [-f] [manifest-path]
#  -a, --attach   Attach/switch to session after restore
#  -f, --force    Recreate windows if names already exist

script_name=$(basename "${0:-codex-restore}")
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
tool_name="${CODEX_TOOL_NAME:-codex}"
case "$script_name" in
  claude-restore) tool_name="${CODEX_TOOL_NAME:-claude}" ;;
  gemini-restore) tool_name="${CODEX_TOOL_NAME:-gemini}" ;;
esac
ADD_BIN="${CODEX_ADD_BIN:-$SCRIPT_DIR/codex-add}"
SESSION_META_BIN="${CODEX_SESSION_META_BIN:-$SCRIPT_DIR/codex-session-meta.py}"
WRITER_WAIT_SECONDS="${CODEXFARM_RESTORE_WRITER_WAIT_SECONDS:-10}"
RESTORE_DELAY="${CODEXFARM_RESTORE_DELAY_SECONDS:-2}"
HEALTH_BIN="${CODEX_HEALTH_BIN:-$SCRIPT_DIR/codex-health}"
ignore_memory=0
MANIFEST_BIN="$SCRIPT_DIR/codex-manifest.py"
PANE_IDENTITY_BIN="${CODEX_PANE_IDENTITY_BIN:-$SCRIPT_DIR/codex-save}"
original_args=("$@")

usage() {
  cat <<EOF
Usage: $script_name [-a|--attach] [-f|--force] [--all-registered] [--list-snapshots]
       [--delay SECONDS] [--ignore-memory-pressure] [manifest-path]

Restore tmux farm windows from a trusted executable manifest.
Provider conversations require exact IDs; latest/continue resumes are disabled.
Use --list-snapshots to find retained snapshots, then pass the chosen path here.
Launches are spaced by 2 seconds (0..300, also CODEXFARM_RESTORE_DELAY_SECONDS).
Critical host memory pressure stops restoration before opening more windows.
--ignore-memory-pressure explicitly bypasses that check; it never stops running chats.
EOF
}

check_memory() {
  [ "$ignore_memory" -eq 1 ] && return 0
  if [ ! -x "$HEALTH_BIN" ]; then
    echo "Memory guard missing; reinstall helpers or use --ignore-memory-pressure." >&2
    return 1
  fi
  if "$HEALTH_BIN" --restore-check; then
    return 0
  fi
  echo "Restore stopped by memory guard. Saved manifest is unchanged; rerun when memory is available." >&2
  return 1
}

strip_status_prefix() {
  local value="$1"
  local old match
  while :; do
    old="$value"
    case "$value" in
      "*READY* "*) value="${value#\*READY\* }" ;;
      "*RUN* "*) value="${value#\*RUN\* }" ;;
      "*ERR* "*) value="${value#\*ERR\* }" ;;
    esac
    if [[ "$value" =~ ^\*[0-9]+(\.[0-9]+)?\+?MB\*\*[[:space:]]* ]]; then
      match="${BASH_REMATCH[0]}"
      value="${value:${#match}}"
    fi
    [ "$value" = "$old" ] && break
  done
  printf '%s' "$value"
}

existing_window_targets() {
  local session="$1"
  local wanted_name="$2"
  local line target name base_name stable_name

  while IFS= read -r line; do
    [ -z "$line" ] && continue
    if [[ "$line" == *$'\t'* ]]; then
      target="${line%%$'\t'*}"
      name="${line#*$'\t'}"
    else
      target="$line"
      name="$line"
    fi
    stable_name="$(
      tmux show-options -p -v -t "$target.0" @codexfarm_name 2>/dev/null || true
    )"
    if [ -n "$stable_name" ]; then
      base_name="$stable_name"
    else
      base_name="$(strip_status_prefix "$name")"
    fi
    if [ "$base_name" = "$wanted_name" ]; then
      printf '%s\n' "$target"
    fi
  done < <(tmux list-windows -t "=$session" -F $'#{window_id}\t#{window_name}')
}

existing_window_target() {
  local session="$1"
  local wanted_name="$2"
  local wanted_occurrence="${3:-1}"
  local target count=0
  while IFS= read -r target; do
    [ -n "$target" ] || continue
    count=$((count + 1))
    if [ "$count" -eq "$wanted_occurrence" ]; then
      printf '%s' "$target"
      return 0
    fi
  done < <(existing_window_targets "$session" "$wanted_name")
  return 1
}

valid_session_id() {
  [[ "$1" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]
}

codex_session_is_writable() {
  local session_id="$1"
  [ -x "$SESSION_META_BIN" ] || return 0
  "$SESSION_META_BIN" wait-writable "$session_id" "$WRITER_WAIT_SECONDS" >/dev/null 2>&1
}

# Bash treats tabs as IFS whitespace and collapses empty columns. Split each
# delimiter explicitly so a missing directory never becomes the command.
parse_manifest_row() {
  local row="$1"
  name="${row%%$'\t'*}"; row="${row#*$'\t'}"
  dir="${row%%$'\t'*}"; row="${row#*$'\t'}"
  cmd="${row%%$'\t'*}"
  args="${row#*$'\t'}"
}

exact_session_id_from_restore() {
  local command="$1"
  local args="$2"
  local values=()
  read -r -a values <<< "$args"
  [ "${#values[@]}" -eq 2 ] || return 1
  case "$command:${values[0]}" in
    codex:resume|claude:--resume|gemini:--resume) ;;
    *) return 1 ;;
  esac
  valid_session_id "${values[1]}" || return 1
  printf '%s' "${values[1]}"
}

next_name_occurrence() {
  local wanted="$1"
  local index
  for index in "${!seen_names[@]}"; do
    if [ "${seen_names[$index]}" = "$wanted" ]; then
      seen_counts[$index]=$((seen_counts[$index] + 1))
      window_occurrence="${seen_counts[$index]}"
      return
    fi
  done
  seen_names+=("$wanted")
  seen_counts+=(1)
  window_occurrence=1
}

name_was_seen() {
  local wanted="$1"
  local value
  for value in "${force_names[@]}"; do
    [ "$value" = "$wanted" ] && return 0
  done
  return 1
}

session_already_present() {
  local wanted="$1"$'\t'"$2" identity
  for identity in "${existing_identities[@]}"; do
    [ "$identity" = "$wanted" ] && return 0
  done
  return 1
}

DEFAULT_SESSION="codexfarm"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/codexfarm"
AUTOSERVICE_REGISTRY="$CONFIG_DIR/farms.tsv"

safe_name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

default_manifest_path_for_session() {
  local session="$1"
  if [ "$session" = "$DEFAULT_SESSION" ]; then
    printf '%s/manifest.tsv' "$CONFIG_DIR"
  else
    printf '%s/manifests/%s.tsv' "$CONFIG_DIR" "$(safe_name "$session")"
  fi
}

attach_to_session() {
  local session="$1"
  if [ -n "${TMUX:-}" ]; then
    tmux switch-client -t "$session"
  else
    tmux attach -t "$session"
  fi
}

restore_all_registered() {
  local attach_requested="$1"
  local force_requested="$2"
  local session manifest status count first_session
  status=0
  count=0
  first_session=""

  if [ ! -f "$AUTOSERVICE_REGISTRY" ]; then
    echo "No registered farms found at $AUTOSERVICE_REGISTRY"
    return 0
  fi

  while IFS=$'\t' read -r session manifest _rest || [ -n "${session:-}" ]; do
    case "${session:-}" in
      ""|"session"|\#*) continue ;;
    esac
    if [ -z "${manifest:-}" ]; then
      manifest="$(default_manifest_path_for_session "$session")"
    fi

    restore_args=("--delay" "$RESTORE_DELAY")
    if [ "$ignore_memory" -eq 1 ]; then
      restore_args+=("--ignore-memory-pressure")
    fi
    if [ "$force_requested" -eq 1 ]; then
      restore_args+=("--force")
    fi
    restore_args+=("$manifest")
    if [ "$count" -gt 0 ]; then
      sleep "$RESTORE_DELAY"
    fi
    if CODEX_SESSION="$session" "$0" "${restore_args[@]}"; then
      count=$((count + 1))
      [ -n "$first_session" ] || first_session="$session"
    else
      status=1
    fi
  done < "$AUTOSERVICE_REGISTRY"

  if [ "$attach_requested" -eq 1 ] && [ -n "$first_session" ]; then
    attach_to_session "$first_session"
  fi
  echo "Restored $count registered farm(s)"
  return "$status"
}

attach=0
force=0
all_registered=0
list_snapshots=0
args_pos=()
while (( "$#" )); do
  case "${1:-}" in
    -a|--attach) attach=1; shift ;;
    -f|--force) force=1; shift ;;
    -h|--help) usage; exit 0 ;;
    --all-registered) all_registered=1; shift ;;
    --ignore-memory-pressure) ignore_memory=1; shift ;;
    --delay)
      if [ "$#" -lt 2 ]; then echo "Missing value for --delay" >&2; exit 2; fi
      RESTORE_DELAY="$2"; shift 2 ;;
    --list-snapshots) list_snapshots=1; shift ;;
    --) shift; while (( "$#" )); do args_pos+=("$1"); shift; done ;;
    -*) echo "Unknown option: $1" >&2; exit 2 ;;
    *) args_pos+=("$1"); shift ;;
  esac
done

if [ "${#args_pos[@]}" -gt 1 ]; then
  echo "Unexpected argument: ${args_pos[1]}" >&2
  exit 2
fi

if [ "$all_registered" -eq 1 ] && [ "${#args_pos[@]}" -gt 0 ]; then
  echo "--all-registered cannot be combined with a manifest path" >&2
  exit 2
fi

if [[ ! "$WRITER_WAIT_SECONDS" =~ ^([0-9]+)(\.[0-9]+)?$ ]]; then
  echo "Invalid CODEXFARM_RESTORE_WRITER_WAIT_SECONDS: $WRITER_WAIT_SECONDS" >&2
  exit 2
fi
if [[ ! "$RESTORE_DELAY" =~ ^[0-9]+(\.[0-9]+)?$ ]] \
  || ! awk -v delay="$RESTORE_DELAY" 'BEGIN { exit !(delay >= 0 && delay <= 300) }'; then
  echo "Invalid restore delay: expected seconds between 0 and 300" >&2
  exit 2
fi

SESSION="${CODEX_SESSION:-$DEFAULT_SESSION}"
MANIFEST_PATH="${args_pos[0]:-$(default_manifest_path_for_session "$SESSION")}"

if [ "$list_snapshots" -eq 1 ]; then
  if [ "$all_registered" -eq 1 ]; then
    echo "--list-snapshots cannot be combined with --all-registered" >&2
    exit 2
  fi
  exec python3 "$MANIFEST_BIN" history "$MANIFEST_PATH"
fi

if [ "$all_registered" -eq 1 ]; then
  if ! command -v tmux >/dev/null; then
    echo "tmux not found" >&2
    exit 127
  fi
  restore_all_registered "$attach" "$force"
  exit $?
fi

if [ ! -f "$MANIFEST_PATH" ]; then
  echo "Manifest not found: $MANIFEST_PATH" >&2
  exit 1
fi

if [ "${CODEXFARM_LOCKED_MANIFEST:-}" != "$MANIFEST_PATH" ] \
  || [ "${CODEXFARM_LOCK_PARENT_PID:-}" != "$PPID" ]; then
  if python3 "$MANIFEST_BIN" lock-run "$MANIFEST_PATH" "$0" "${original_args[@]}"; then
    # The snapshot transaction ends before attaching to an interactive client.
    if [ "$attach" -eq 1 ]; then
      attach_to_session "$SESSION"
    fi
    exit 0
  else
    exit $?
  fi
fi

# Validate the entire manifest before touching tmux, including --force. Use one
# stable, normalized copy throughout restore even if the source is replaced.
validated_manifest=$(mktemp)
trap 'rm -f "$validated_manifest"' EXIT
python3 "$MANIFEST_BIN" validate --resolve-codex "$MANIFEST_PATH" > "$validated_manifest" || exit 2

if ! command -v tmux >/dev/null; then
  echo "tmux not found" >&2
  exit 127
fi

# Ensure session exists
check_memory || exit 3
tmux has-session -t "=$SESSION" 2>/dev/null || tmux new-session -d -s "$SESSION" -n home

existing_identities=()
if [ "$force" -eq 0 ]; then
  existing_windows=$(tmux list-windows -t "=$SESSION" -F $'#{window_id}\t#{window_name}')
  while IFS= read -r window; do
    [ -n "$window" ] || continue
    target="${window%%$'\t'*}"
    dead=$(tmux display-message -p -t "$target.0" '#{pane_dead}')
    [ "$dead" != 1 ] || continue
    identity=$("$PANE_IDENTITY_BIN" --inspect-pane "$target.0" 2>/dev/null || true)
    [ -z "$identity" ] || existing_identities+=("$identity")
  done <<< "$existing_windows"
fi

force_names=()
if [ "$force" -eq 1 ]; then
  {
    IFS= read -r _header || true
    while IFS= read -r row; do
      parse_manifest_row "$row"
      if name_was_seen "$name"; then
        continue
      fi
      force_names+=("$name")
      while IFS= read -r existing_target; do
        [ -n "$existing_target" ] || continue
        check_memory || exit 3
        if ! tmux kill-window -t "$existing_target"; then
          echo "Unable to remove existing window '$name' during force restore." >&2
          exit 1
        fi
      done < <(existing_window_targets "$SESSION" "$name")
    done
  } < "$validated_manifest"
fi

# Read manifest; skip header
seen_names=()
seen_counts=()
restore_failures=0
restored=0
{
  IFS= read -r _header || true
  while IFS= read -r row; do
    parse_manifest_row "$row"
    next_name_occurrence "$name"
    restore_dir="${dir:-$HOME}"
    if [ ! -d "$restore_dir" ]; then
      echo "Warning: saved directory not found, using HOME: $restore_dir" >&2
      restore_dir="$HOME"
    fi
    RESTORE_CMD="$cmd"
    RESTORE_ARGS="$args"
    restore_provider="$tool_name"
    case "$RESTORE_CMD" in
      codex|claude|gemini) restore_provider="$RESTORE_CMD" ;;
    esac

    exact_session_id="$(
      exact_session_id_from_restore "$RESTORE_CMD" "$RESTORE_ARGS" || true
    )"
    if [ "$force" -eq 0 ]; then
      if [ -n "$exact_session_id" ] && session_already_present "$RESTORE_CMD" "$exact_session_id"; then
        echo "Skipping existing conversation: $name"
        continue
      fi
      existing_target="$(
        existing_window_target "$SESSION" "$name" "$window_occurrence" || true
      )"
      if [ -n "$existing_target" ]; then
        if [ -n "$exact_session_id" ]; then
          echo "Existing window '$name' has a different or unverified conversation; use --force to replace it or restore into another farm." >&2
          restore_failures=$((restore_failures + 1))
        else
          echo "Skipping existing window: $name"
        fi
        continue
      fi
    fi
    if [ "$RESTORE_CMD" = "codex" ] && [ -n "$exact_session_id" ]; then
      if ! codex_session_is_writable "$exact_session_id"; then
        echo "Unable to restore Codex window '$name': its conversation is active in another Codex process." >&2
        echo "Switch to it with /resume in the owning TUI, or exit that Codex process and rerun codex-restore." >&2
        restore_failures=$((restore_failures + 1))
        continue
      fi
    fi

    if [ "$restored" -gt 0 ]; then
      sleep "$RESTORE_DELAY"
    fi
    check_memory || exit 3
    if ! CODEXFARM_RESTORE_PID="$$" \
      CODEX_TOOL_NAME="$restore_provider" \
      CODEX_NAME="$name" \
      CODEX_CMD="$RESTORE_CMD" \
      CODEX_ARGS="$RESTORE_ARGS" \
      "$ADD_BIN" -d "$restore_dir"; then
      echo "Unable to launch saved window: $name" >&2
      restore_failures=$((restore_failures + 1))
      continue
    fi
    restored=$((restored + 1))

    if [ -n "$exact_session_id" ]; then
      created_target="$(
        existing_window_target "$SESSION" "$name" "$window_occurrence" || true
      )"
      if [ -n "$created_target" ]; then
        if ! tmux set-option -p -t "$created_target.0" \
          @codexfarm_provider "$RESTORE_CMD" >/dev/null 2>&1 \
          || ! tmux set-option -p -t "$created_target.0" \
            @codexfarm_session_source restore >/dev/null 2>&1 \
          || ! tmux set-option -p -t "$created_target.0" \
            @codexfarm_session_id "$exact_session_id" >/dev/null 2>&1
        then
          echo "Warning: unable to seed exact session metadata for window: $name" >&2
        fi
      fi
    fi
  done
} < "$validated_manifest"

if [ "$restore_failures" -ne 0 ]; then
  echo "Restore incomplete: $restore_failures window(s) could not be restored." >&2
  exit 1
fi

echo "Restore complete from $MANIFEST_PATH"
