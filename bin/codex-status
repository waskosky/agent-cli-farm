#!/usr/bin/env bash
set -euo pipefail

# List and manage Agent CLI Farm sessions
# Usage: codex-status [--session SESSION] [sessions|windows|activity|logs|loopers]

SCRIPT_PATH="${BASH_SOURCE[0]}"
SCRIPT_DIR="${SCRIPT_PATH%/*}"
if [ "$SCRIPT_DIR" = "$SCRIPT_PATH" ]; then
    SCRIPT_DIR="."
fi
SCRIPT_DIR="$(cd "$SCRIPT_DIR" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PYTHONPATH_BASE="$REPO_ROOT:$SCRIPT_DIR"
DEFAULT_SESSION="codexfarm"

board_session_name() {
    local session="$1"
    if [ "$session" = "$DEFAULT_SESSION" ]; then
        printf '%s' "board"
    else
        printf '%s-board' "$session"
    fi
}

ACTION="sessions"
SESSION="${CODEX_SESSION:-$DEFAULT_SESSION}"
action_set=0
session_set=0
REPAIR_STALE_LOOPERS=0

while (( "$#" )); do
    case "${1:-}" in
        -s|--session)
            if [ "$#" -lt 2 ]; then
                echo "Missing value for $1" >&2
                exit 2
            fi
            SESSION="$2"
            session_set=1
            shift 2
            ;;
        sessions|windows|activity|logs|loopers)
            ACTION="$1"
            action_set=1
            shift
            ;;
        --repair-stale|--repair-stale-loopers)
            REPAIR_STALE_LOOPERS=1
            shift
            ;;
        -h|--help)
            ACTION="help"
            action_set=1
            shift
            ;;
        --)
            shift
            break
            ;;
        -*)
            echo "Unknown option: $1" >&2
            exit 2
            ;;
        *)
            if [ "$session_set" -eq 0 ] && [ "$action_set" -eq 0 ]; then
                SESSION="$1"
                session_set=1
            elif [ "$action_set" -eq 0 ]; then
                ACTION="$1"
                action_set=1
            else
                echo "Unexpected argument: $1" >&2
                exit 2
            fi
            shift
            ;;
    esac
done

BOARD_SESSION="$(board_session_name "$SESSION")"
STATE_BASENAME="${CODEX_STATE_BASENAME:-codexfarm}"
LOGDIR="${XDG_STATE_HOME:-$HOME/.local/state}/$STATE_BASENAME/logs"
ACTIVITY_LINES="${CODEX_STATUS_ACTIVITY_LINES:-8}"
case "$ACTIVITY_LINES" in
    ''|*[!0-9]*|0) ACTIVITY_LINES=8 ;;
esac

case "$ACTION" in
    help|logs|loopers) ;;
    *)
        if ! command -v tmux >/dev/null; then
            echo "tmux not found" >&2
            exit 127
        fi
        ;;
esac

stat_epoch() {
    local path="$1"
    if stat -c '%Y' "$path" >/dev/null 2>&1; then
        stat -c '%Y' "$path"
    elif stat -f '%m' "$path" >/dev/null 2>&1; then
        stat -f '%m' "$path"
    else
        return 1
    fi
}

stat_human() {
    local path="$1"
    if stat -c '%y' "$path" >/dev/null 2>&1; then
        stat -c '%y' "$path"
    elif stat -f '%Sm' "$path" >/dev/null 2>&1; then
        stat -f '%Sm' -t '%c' "$path"
    else
        return 1
    fi
}

case "$ACTION" in
    sessions)
        echo "=== Tmux Sessions ==="
        if tmux list-sessions 2>/dev/null; then
            echo ""
            if tmux has-session -t "$SESSION" 2>/dev/null; then
                echo "Main Codex session '$SESSION' is running"
            else
                echo "Main Codex session '$SESSION' is not running"
            fi
            
            if tmux has-session -t "$BOARD_SESSION" 2>/dev/null; then
                echo "Board session '$BOARD_SESSION' is running"
            else
                echo "Board session '$BOARD_SESSION' is not running"
            fi
        else
            echo "No tmux sessions running"
        fi
        ;;
    
    windows)
        echo "=== Codex Windows ==="
        if tmux has-session -t "$SESSION" 2>/dev/null; then
            tmux list-windows -t "$SESSION" -F "#{window_index}	#{window_name}	#{pane_current_path}	#{@codex_state}	#{@codex_last_ready}" |
              while IFS=$'\t' read -r index name path state last_ready; do
                state="${state:-UNKNOWN}"
                if [ -n "${last_ready:-}" ]; then
                    printf '%s: [%s] %s (%s) ready_at=%s\n' "$index" "$state" "$name" "$path" "$last_ready"
                else
                    printf '%s: [%s] %s (%s)\n' "$index" "$state" "$name" "$path"
                fi
              done
        else
            echo "Main session '$SESSION' is not running"
        fi
        ;;

    activity)
        echo "=== Agent Activity ==="
        if tmux has-session -t "$SESSION" 2>/dev/null; then
            tmux list-windows -t "$SESSION" -F "#{window_id}	#{window_index}	#{window_name}	#{@codex_state}	#{@codex_stop_reason}" |
              while IFS=$'\t' read -r window_id index name state stop_reason; do
                state="${state:-UNKNOWN}"
                pane_line="$(tmux list-panes -t "$window_id" -F "#{pane_id}	#{pane_current_path}	#{pane_current_command}	#{pane_start_command}" 2>/dev/null | head -n 1 || true)"
                IFS=$'\t' read -r pane_id path pane_command start_command <<< "$pane_line"
                path="${path:-unknown}"
                command="${start_command:-${pane_command:-unknown}}"

                printf '%s: [%s] %s (%s)\n' "$index" "$state" "$name" "$path"
                printf '    command: %s\n' "$command"
                if [ -n "${stop_reason:-}" ]; then
                    printf '    stop: %s\n' "$stop_reason"
                fi
                if [ -n "${pane_id:-}" ]; then
                    recent="$(tmux capture-pane -t "$pane_id" -p -S "-$ACTIVITY_LINES" 2>/dev/null || true)"
                    if [ -n "$recent" ]; then
                        printf '    recent:\n'
                        printf '%s\n' "$recent" | sed 's/^/      /'
                    fi
                fi
              done
        else
            echo "Main session '$SESSION' is not running"
        fi
        ;;
    
    logs)
        echo "=== Log Files ==="
        if [ -d "$LOGDIR" ]; then
            find "$LOGDIR" -name "*.log" -print0 | while IFS= read -r -d '' file; do
                epoch="$(stat_epoch "$file" || true)"
                human="$(stat_human "$file" || true)"
                [ -n "$epoch" ] && printf '%s %s %s\n' "$epoch" "$human" "$file"
            done | sort -n | cut -d' ' -f2-
            echo ""
            echo "Total logs: $(find "$LOGDIR" -name "*.log" | wc -l)"
        else
            echo "Log directory doesn't exist: $LOGDIR"
        fi
        ;;

    loopers)
        CODEX_STATUS_REPAIR_STALE_LOOPERS="$REPAIR_STALE_LOOPERS" PYTHONPATH="$PYTHONPATH_BASE${PYTHONPATH:+:$PYTHONPATH}" python3 - <<'PY'
from __future__ import annotations

import os
from pathlib import Path
from typing import Any

from codex_looper.status_state import iter_looper_state_views


def text(value: Any, default: str = "-") -> str:
    if value is None or value == "":
        return default
    return str(value)


root = Path(os.environ.get("CODEX_LOOPER_STATE_ROOT") or Path.cwd() / ".agent-looper" / "runs")
repair_stale = os.environ.get("CODEX_STATUS_REPAIR_STALE_LOOPERS") == "1"
print("=== Looper Runs ===")
if not root.exists():
    print(f"No looper runs found at {root}")
    raise SystemExit(0)

states = list(iter_looper_state_views(root, repair_stale=repair_stale))

if not states:
    print(f"No looper state files found at {root}")
    raise SystemExit(0)

for view in sorted(states, key=lambda item: item.sort_key, reverse=True):
    state_path = view.state_path
    state = view.state
    label = text(state.get("label") or state_path.parent.name)
    status = text(state.get("status"), "unknown")
    if view.stale:
        status = "stale"
    agent_name = text(state.get("agent_name"), "unknown")
    agent_kind = text(state.get("agent_kind"), "unknown")
    loop = text(state.get("current_loop"))
    prompt = text(state.get("current_prompt_index"))
    session = text(state.get("current_session_id") or state.get("current_session"))
    print(f"{label}: [{status}] {agent_name}/{agent_kind} loop={loop} prompt={prompt} session={session}")
    if state.get("updated_at"):
        print(f"    updated: {state['updated_at']}")
    print(f"    run: {text(state.get('run_dir') or state_path.parent)}")
    if view.stale_reason:
        prefix = "repaired" if view.repaired else "stale"
        print(f"    {prefix}: {view.stale_reason}")
    if state.get("stop_reason"):
        print(f"    stop: {state['stop_reason']}")
    if state.get("last_log"):
        print(f"    log: {state['last_log']}")
    if state.get("exit_code") is not None:
        print(f"    exit: {state['exit_code']}")
PY
        ;;
    
    help|*)
        echo "Usage: $(basename "$0") [--session SESSION] [sessions|windows|activity|logs|loopers]"
        echo "  sessions - Show tmux sessions status"
        echo "  windows  - Show Codex windows in main session"
        echo "  activity - Show window status, command, and recent pane output"
        echo "  logs     - Show log files"
        echo "  loopers  - Show durable looper run state from .agent-looper/runs"
        echo "Options:"
        echo "  --repair-stale-loopers  Mark active looper states stopped when their supervisor pid is gone"
        if [ "$ACTION" = "help" ]; then
            exit 0
        fi
        exit 1
        ;;
esac
