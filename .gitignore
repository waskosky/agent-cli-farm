# .gitignore for Codex CLI Farm

# Temporary files
/tmp/
*.tmp
*.temp
__pycache__/
*.pyc

# Log files (these are created in user's home directory)
*.log

# Build artifacts (if any are added later)
/dist/
/build/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Runtime directories that may be created during testing
/.local/
/.worktrees/
/bin
!/bin/codex-annotator.py
/tests
!/tests/
!/tests/test_annotator_status.py
!/tests/test_add_scripts.py
!/tests/test_claude_wrappers.py
!/tests/test_codex_annotator.py
